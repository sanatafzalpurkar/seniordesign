def detect_tags(gray_img):
    """Find AprilTags. Returns (corners, ids) like detectMarkers.
    1) standard search  2) tuned search on a contrast-boosted picture
    3) zoomed search where a wanted tag was last seen, if still missed."""
    wanted = {TAG_ID, *REF_TAGS}
    result = {}

    def add(found_c, found_i):
        if found_i is not None:
            for c, i in zip(found_c, found_i.flatten()):
                if int(i) in wanted and int(i) not in result:
                    result[int(i)] = c.reshape(4, 2).astype(np.float32)

    # 1) standard search (best for sharp tags)
    c1, i1, _ = detector_plain.detectMarkers(gray_img)
    add(c1, i1)
    img = clahe.apply(gray_img) if TAG_CONTRAST_BOOST else gray_img
    # 2) tuned search on the contrast-boosted picture, only if something is missing
    if wanted - set(result):
        c2, i2, _ = detector.detectMarkers(img)
        add(c2, i2)
    if TAG_ZOOM_SEARCH:
        ih, iw = img.shape[:2]
        for tid in [TAG_ID] + list(REF_TAGS):
            if tid in result or tid not in last_tag_box:
                continue
            cx, cy0, size = last_tag_box[tid]
            half = int(max(40, size * 2.5))
            x0, y0 = max(0, int(cx - half)), max(0, int(cy0 - half))
            x1, y1 = min(iw, int(cx + half)), min(ih, int(cy0 + half))
            if x1 - x0 < 20 or y1 - y0 < 20:
                continue
            crop = cv2.resize(img[y0:y1, x0:x1], None, fx=2.0, fy=2.0,
                              interpolation=cv2.INTER_CUBIC)
            zc, zi, _ = detector.detectMarkers(crop)
            if zi is None:
                continue
            for c, i in zip(zc, zi.flatten()):
                if int(i) == tid:
                    pts = c.reshape(4, 2) / 2.0 + np.array([x0, y0], np.float32)
                    result[tid] = pts.astype(np.float32)
    for tid, pts in result.items():
        last_tag_box[tid] = (float(pts[:, 0].mean()), float(pts[:, 1].mean()),
                             float(np.linalg.norm(pts[1] - pts[0])))
    if not result:
        return (), None
    ids_sorted = sorted(result)
    return ([result[t].reshape(1, 4, 2) for t in ids_sorted],
            np.array(ids_sorted, dtype=np.int32).reshape(-1, 1))

