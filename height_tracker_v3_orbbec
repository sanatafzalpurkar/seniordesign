def format_height(height_cm):
    """Return the height as (imperial text, metric text)."""
    total_inches = height_cm / 2.54
    feet = int(total_inches // 12)
    inches = total_inches - feet * 12
    if inches >= 11.95:          # avoid showing "4 ft 12.0 in"
        feet += 1
        inches = 0.0
    imperial = f"{feet} ft {inches:.1f} in"
    metric = f"{height_cm:.1f} cm ({height_cm / 100:.2f} m)"
    return imperial, metric


def forward_distance(measured_cm, side_cm, up_down_cm):
    """Straight-ahead distance along the floor (what the math needs).
    If the tape went diagonally from the lens, remove the sideways and
    up/down parts of that line."""
    if not DISTANCES_MEASURED_DIAGONALLY:
        return measured_cm
    flat_sq = measured_cm ** 2 - side_cm ** 2 - up_down_cm ** 2
    if flat_sq <= 0:
        print("WARNING: side/height offsets are larger than the measured distance - check them.")
        return measured_cm
    return math.sqrt(flat_sq)


def build_height_correction():
    """Returns (correct(raw_cm) -> cm, description) from KNOWN_HEIGHTS."""
    pts = [(float(t), float(r)) for t, r in KNOWN_HEIGHTS]
    if not pts:
        return (lambda raw: raw * CALIBRATION_FACTOR + HEIGHT_OFFSET_CM,
                "factor/offset (KNOWN_HEIGHTS is empty)")
    trues = np.array([p[0] for p in pts])
    raws = np.array([p[1] for p in pts])
    if len(pts) == 1 or raws.max() - raws.min() < 5.0:
        off = float(np.mean(trues - raws))
        return (lambda raw: raw + off,
                f"offset {off:+.1f} cm from {len(pts)} known height(s)")
    deg = 2 if len(pts) >= 4 else 1
    poly = np.poly1d(np.polyfit(raws, trues, deg))
    slope = poly.deriv()
    lo, hi = float(raws.min()), float(raws.max())

    def correct(raw):
        # Outside the tested range keep going in a straight line,
        # so the curve can't run away for very short/tall patients
        if raw < lo:
            return float(poly(lo) + slope(lo) * (raw - lo))
        if raw > hi:
            return float(poly(hi) + slope(hi) * (raw - hi))
        return float(poly(raw))

    kind = "straight-line" if deg == 1 else "curved"
    for t, r in pts:
        print(f"  known height {t:.1f} cm: raw {r:.1f} -> corrected {correct(r):.1f} "
              f"(left over {correct(r) - t:+.1f} cm)")
    return correct, f"{kind} fit from {len(pts)} known heights"


def find_head_top(mask, x_center, half_width, start_y):
    """Scan UP from start_y (nose) inside a narrow column until the
    person outline ends. Returns the y of the top of the head/hair
    (with sub-pixel precision), or None if the mask is unavailable."""
    if mask is None or start_y <= 0:
        return None
    mh, mw = mask.shape[:2]
    start_y = min(start_y, mh)
    x0 = max(0, x_center - half_width)
    x1 = min(mw, x_center + half_width)
    if x1 <= x0:
        return None
    width = x1 - x0
    # Fraction of the column covered by the person, row by row
    cover = (mask[:start_y, x0:x1] > MASK_THRESHOLD).mean(axis=1)
    min_cover = max(3.0 / width, HEAD_TOP_COVER)
    gaps = np.where(cover < min_cover)[0]
    if len(gaps) == 0:
        return 0.0
    r = int(gaps[-1])                  # last row above the head (outside the person)
    if r + 1 >= start_y:
        return float(start_y)
    # Sub-pixel: where between row r and r+1 the coverage crosses the limit.
    # Each pixel is ~0.3 cm at the patient, so this steadies the reading.
    a, b = cover[r], cover[r + 1]
    frac = (min_cover - a) / (b - a) if b > a else 1.0
    return r + float(np.clip(frac, 0.0, 1.0))


def find_feet_bottom(mask, x0, x1, start_y):
    """Scan DOWN from start_y (ankles) until the person outline ends.
    Returns the y where the feet touch the floor (display only)."""
    if mask is None:
        return None
    mh, mw = mask.shape[:2]
    x0 = max(0, x0)
    x1 = min(mw, x1)
    if x1 <= x0 or start_y >= mh:
        return None
    counts = (mask[start_y:, x0:x1] > MASK_THRESHOLD).sum(axis=1)
    min_px = max(3, int((x1 - x0) * 0.05))
    gaps = np.where(counts < min_px)[0]
    return int(start_y + gaps[0] - 1) if len(gaps) else mh - 1


BANNER_SIZE = 0.6        # text size of the bottom banner (bigger number = bigger text)
BANNER_OPACITY = 0.45    # 0 = see-through, 1 = solid black (so the feet stay visible)


def draw_banner(frame, text, color):
    """Instruction banner along the bottom of the screen for the patient
    (thin and see-through, so the feet stay visible)."""
    h, w = frame.shape[:2]
    scale = max(0.5, w / 900 * BANNER_SIZE)
    thickness = max(1, int(scale * 2))
    lines = text.split("\n")
    line_h = int(36 * scale)
    top = h - line_h * len(lines) - 14
    overlay = frame.copy()
    cv2.rectangle(overlay, (0, top - 6), (w, h), (25, 25, 25), -1)
    cv2.addWeighted(overlay, BANNER_OPACITY, frame, 1 - BANNER_OPACITY, 0, dst=frame)
    for i, line in enumerate(lines):
        (tw, _), _ = cv2.getTextSize(line, cv2.FONT_HERSHEY_SIMPLEX, scale, thickness)
        x = max(10, (w - tw) // 2)
        y = top + line_h * (i + 1) - 10
        cv2.putText(frame, line, (x, y), cv2.FONT_HERSHEY_SIMPLEX,
                    scale, color, thickness)


def draw_center_text(frame, lines, color, size=1.0):
    """Big outlined text in the middle of the screen (countdown / picture taken)."""
    h, w = frame.shape[:2]
    font = cv2.FONT_HERSHEY_DUPLEX
    base = w / 450
    total_h = 0
    sized = []
    for i, line in enumerate(lines):
        scale = max(0.6, base * (size * 3.0 if i == 0 else max(size, 0.8)))
        thick = max(2, int(scale * 2.5))
        (tw, th), _ = cv2.getTextSize(line, font, scale, thick)
        sized.append((line, scale, thick, tw, th))
        total_h += th + int(20 * base)
    y = (h - total_h) // 2
    for line, scale, thick, tw, th in sized:
        y += th
        x = (w - tw) // 2
        cv2.putText(frame, line, (x, y), font, scale, (0, 0, 0), thick + 6)   # outline
        cv2.putText(frame, line, (x, y), font, scale, color, thick)
        y += int(20 * base)


def point_distance_cm(row, cy, focal_px, tilt, drop_cm):
    """Horizontal distance (cm) from the camera to a point seen at this image
    row that sits drop_cm below the camera lens. Used only for the
    standing-line check (not for the height). Uses the LIVE tilt."""
    angle_down = tilt + np.arctan((row - cy) / focal_px)
    if angle_down <= np.radians(1.0):      # at/above the horizon: not usable
        return None
    return drop_cm / np.tan(angle_down)


