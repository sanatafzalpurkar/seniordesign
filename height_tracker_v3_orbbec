# ============================================
# MAIN CAMERA LOOP
# ============================================

try:
    while True:

        ret, frame = cap.read()

        if not ret:
            # The iPhone camera drops out now and then: wait and reconnect
            # instead of quitting (gives up after about 30 s without a picture)
            if missed_frames == 0:
                print("Camera dropped out - waiting for it to come back...")
            missed_frames += 1
            if missed_frames % 20 == 0:          # every ~2 s, reopen the camera
                cap.release()
                cap = cv2.VideoCapture(CAMERA_INDEX, cv2.CAP_AVFOUNDATION)
                configure_camera(cap)
            if missed_frames > 300:
                print("Could not read camera frame for 30 s - stopping.")
                break
            if cv2.waitKey(100) & 0xFF in (ord("q"), ord("Q")):
                break
            continue
        if missed_frames:
            print("Camera is back.")
            missed_frames = 0

        # Rotate vertically mounted camera upright
        if ROTATE is not None:
            frame = cv2.rotate(frame, ROTATE)

        h, w = frame.shape[:2]
        cy = h / 2.0

        # Measure how many frames per second we really get, so the
        # countdown shows real seconds (smoothed so it doesn't jump around)
        _t = time.monotonic()
        _dt = _t - last_frame_at
        last_frame_at = _t
        if 0 < _dt < 1.0:
            fps_est = 0.9 * fps_est + 0.1 * (1.0 / _dt)

        # ------------------------------------
        # DETECT APRILTAG
        # Must run on the UNMIRRORED frame: a mirrored
        # AprilTag decodes as an invalid code, so
        # detectMarkers() always returns None.
        # ------------------------------------

        tag_found = False
        tag_pts = None
        ref_draw = []

        if detector is not None:

            gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)

            corners, ids = detect_tags(gray)

            if ids is not None:

                for i, marker_id in enumerate(ids.flatten()):

                    # Ruler tags (NEW): only their center row is needed
                    if int(marker_id) in ref_rows:
                        rpts = corners[i].reshape(4, 2).copy()
                        ref_rows[int(marker_id)].append(float(rpts[:, 1].mean()))
                        redges = [rpts[(j + 1) % 4] - rpts[j] for j in range(4)]
                        rh = [np.linalg.norm(e) for e in redges if abs(e[0]) >= abs(e[1])]
                        if rh:
                            ref_widths[int(marker_id)].append(float(np.mean(rh)))
                        rpts[:, 0] = (w - 1) - rpts[:, 0]      # mirrored, for drawing
                        ref_draw.append(rpts)
                        continue

                    if marker_id != TAG_ID or tag_found:
                        continue

                    pts = corners[i].reshape(4, 2).copy()

                    # Use the two most HORIZONTAL edges: a downward tilt
                    # shrinks the vertical edges but not the horizontal ones
                    edges = [pts[(j + 1) % 4] - pts[j] for j in range(4)]
                    horiz = [
                        np.linalg.norm(e) for e in edges
                        if abs(e[0]) >= abs(e[1])
                    ]
                    if len(horiz) == 0:
                        horiz = [np.linalg.norm(e) for e in edges]
                    tag_width_px = float(np.mean(horiz))

                    if tag_width_px > 5:

                        tag_center_y = float(pts[:, 1].mean())

                        # Angle from the camera down to the tag center,
                        # known from the measured booth geometry
                        tag_drop_cm = cam_h_cm - tag_h_cm
                        tag_angle = np.arctan(tag_drop_cm / tag_dist_cm)

                        # Solve tilt and focal length together (they depend
                        # on each other, so repeat until they settle)
                        tilt_est = tilt_rad
                        for _ in range(10):
                            tag_z_cm = (
                                tag_dist_cm * np.cos(tilt_est)
                                + tag_drop_cm * np.sin(tilt_est)
                            )
                            # Focal length in pixels: tag width = f * width / depth.
                            # Uses the HORIZONTAL edges, so it must use the
                            # real left-right width of the printed tag.
                            f_est = tag_width_px * tag_z_cm / TAG_WIDTH_CM

                            if not AUTO_TILT:
                                break

                            # Tilt = (angle down to tag) - (tag's angle
                            # below the image center)
                            tilt_est = tag_angle - np.arctan(
                                (tag_center_y - cy) / f_est
                            )

                        # Keep updating: the newest readings replace the oldest
                        focal_history.append(f_est)
                        tilt_history.append(tilt_est)

                        # Camera clearly changed? Keep only the newest readings
                        if len(tilt_history) >= 20:
                            new_tilt = np.median(list(tilt_history)[-10:])
                            new_focal = np.median(list(focal_history)[-10:])
                            tilt_jump = abs(np.degrees(new_tilt - np.median(tilt_history)))
                            focal_jump = abs(new_focal / np.median(focal_history) - 1) * 100
                            if tilt_jump > CHANGE_TILT_DEG or focal_jump > CHANGE_FOCAL_PCT:
                                keep_t = list(tilt_history)[-10:]
                                keep_f = list(focal_history)[-10:]
                                tilt_history.clear(); tilt_history.extend(keep_t)
                                focal_history.clear(); focal_history.extend(keep_f)
                                print(f"Camera change detected (tilt {tilt_jump:.2f} deg, "
                                      f"zoom {focal_jump:.1f}%) - updated.")

                        tag_found = True

                        # Convert corners to mirrored-frame
                        # coordinates for drawing
                        pts[:, 0] = (w - 1) - pts[:, 0]
                        tag_pts = pts

        # Camera focal length (pixels) and tilt, from the most recent tag
        # readings. Updated live whenever the tag is visible; if the tag is
        # hidden, the last readings are kept.
        focal_px = float(np.median(focal_history)) if focal_history else None
        if len(focal_history) >= MIN_CALIBRATION_FRAMES:
            ever_calibrated = True
        calibrated = ever_calibrated and bool(focal_history)

        # Camera tilt: measured from the tag (AUTO_TILT) or typed in
        if AUTO_TILT and tilt_history:
            tilt_used = float(np.median(tilt_history))
        else:
            tilt_used = tilt_rad

        # Ruler from the reference tags (NEW)
        if ref_rows and focal_px is not None:
            ruler, ruler_tags = ruler_fit(focal_px, tilt_used, cy)

        # Mirror webcam AFTER tag detection
        # (display, MediaPipe and screenshots stay mirrored)
        frame = cv2.flip(frame, 1)

        if tag_pts is not None:
            cv2.polylines(frame, [tag_pts.astype(np.int32)], True, (255, 0, 255), 2)
        for rp in ref_draw:
            cv2.polylines(frame, [rp.astype(np.int32)], True, (0, 255, 0), 2)

        # ------------------------------------
        # DETECT BODY
        # ------------------------------------

        rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
        results = pose.process(rgb)

        # ---- POSTURE (NEW, Sanat's checker) ----
        posture_state = posture.update(results, w, h)

        # Extra front-view checks (NEW): uneven shoulders and leaning to one side
        frame_issues = []
        if results.pose_landmarks:
            plm = results.pose_landmarks.landmark
            if min(plm[i].visibility for i in (L_SH, R_SH, L_HIP, R_HIP)) >= MIN_VISIBILITY:
                if abs(_tilt_deg(plm[L_SH], plm[R_SH], w, h)) > SHOULDER_TILT_MAX_DEG * LENIENCY:
                    frame_issues.append("Level your shoulders")
                sx = (plm[L_SH].x + plm[R_SH].x) / 2 * w
                sy = (plm[L_SH].y + plm[R_SH].y) / 2 * h
                hx = (plm[L_HIP].x + plm[R_HIP].x) / 2 * w
                hy = (plm[L_HIP].y + plm[R_HIP].y) / 2 * h
                if math.degrees(math.atan2(abs(sx - hx), abs(hy - sy) + 1e-6)) > SIDE_LEAN_MAX_DEG * LENIENCY:
                    frame_issues.append("Stand up straight - don't lean")
        if frame_issues:
            extra_bad_count += 1
            extra_good_count = 0
            extra_issues = frame_issues
            if extra_bad_count >= POSTURE_2D_FRAMES:
                extra_flag = True
        else:
            extra_good_count += 1
            extra_bad_count = 0
            if extra_good_count >= POSTURE_2D_FRAMES:
                extra_flag = False

        all_issues = (extra_issues if extra_flag else []) + posture_state["issues"]
        posture_bad = POSTURE_CHECK_ON and (posture_state["status"] == "bad" or extra_flag)

        # Facing the camera? (NEW) shoulder width vs torso length, in the picture
        facing_now = True
        if results.pose_landmarks:
            flm = results.pose_landmarks.landmark
            if min(flm[i].visibility for i in (L_SH, R_SH, L_HIP, R_HIP)) >= MIN_VISIBILITY * 0.6:
                span = abs(flm[L_SH].x - flm[R_SH].x) * w
                torso = abs((flm[L_SH].y + flm[R_SH].y) - (flm[L_HIP].y + flm[R_HIP].y)) / 2 * h
                if torso > 1 and span / torso < FACING_MIN_RATIO:
                    facing_now = False
            # turned so far that a shoulder or hip disappears: also sideways
            elif min(flm[L_SH].visibility, flm[R_SH].visibility) < 0.2:
                facing_now = False
        if facing_now:
            facing_good += 1
            facing_bad = 0
            if facing_good >= FACING_FRAMES:
                not_facing = False
        else:
            facing_bad += 1
            facing_good = 0
            if facing_bad >= FACING_FRAMES:
                not_facing = True
        for issue in POSTURE_ISSUE_ORDER:
            if issue in all_issues:
                posture_issue = issue
                break
        else:
            if all_issues:
                posture_issue = all_issues[0]
            elif not posture_issue:
                posture_issue = "Stand up straight - don't slouch"
        if posture_bad:
            if posture_bad_since is None:
                posture_bad_since = time.monotonic()
                print("  Posture: " + " | ".join(all_issues))
            if time.monotonic() - posture_bad_since >= POSTURE_GIVE_UP_SEC:
                posture_bad = False      # waited long enough: measure anyway
        else:
            posture_bad_since = None

        person_seen = results.pose_landmarks is not None
        full_body = False
        height_now = None
        height_raw = None
        line_offset_cm = None    # + = behind the footprints, - = in front of them

        if person_seen:

            landmarks = results.pose_landmarks.landmark

            mp_drawing.draw_landmarks(
                frame,
                results.pose_landmarks,
                mp_pose.POSE_CONNECTIONS
            )

            L = mp_pose.PoseLandmark
            nose = landmarks[L.NOSE]
            left_ear, right_ear = landmarks[L.LEFT_EAR], landmarks[L.RIGHT_EAR]
            left_shoulder, right_shoulder = landmarks[L.LEFT_SHOULDER], landmarks[L.RIGHT_SHOULDER]
            left_ankle, right_ankle = landmarks[L.LEFT_ANKLE], landmarks[L.RIGHT_ANKLE]
            left_heel, right_heel = landmarks[L.LEFT_HEEL], landmarks[L.RIGHT_HEEL]
            left_toe, right_toe = landmarks[L.LEFT_FOOT_INDEX], landmarks[L.RIGHT_FOOT_INDEX]
            left_eye, right_eye = landmarks[L.LEFT_EYE], landmarks[L.RIGHT_EYE]
            mouth_l, mouth_r = landmarks[L.MOUTH_LEFT], landmarks[L.MOUTH_RIGHT]

            # The height math only uses the HEAD, so the feet only need to be
            # roughly visible (to confirm the patient is standing in place).
            upper_ok = all(
                p.visibility > BODY_VISIBILITY
                for p in (nose, left_shoulder, right_shoulder)
            )
            ankles_ok = all(
                p.visibility > ANKLE_VISIBILITY
                for p in (left_ankle, right_ankle)
            )

            if upper_ok and ankles_ok:

                nose_y = int(nose.y * h)
                ankle_y = int(max(left_ankle.y, right_ankle.y) * h)

                # Head center = midpoint between the ears
                center_x = int((left_ear.x + right_ear.x) / 2 * w)
                ear_span = int(abs(left_ear.x - right_ear.x) * w)

                mask = results.segmentation_mask

                # ---- TOP OF HEAD from the person outline ----
                head_top_y = find_head_top(
                    mask, center_x, max(8, ear_span // 4), nose_y
                )
                if head_top_y is None:
                    # Fallback estimate from the nose-to-ankle distance
                    head_top_y = int(nose_y - (ankle_y - nose_y) * 0.15)

                # ---- FEET (display only) ----
                foot_xs = [
                    p.x * w for p in
                    (left_heel, right_heel, left_toe, right_toe,
                     left_ankle, right_ankle)
                ]
                margin = max(10, ear_span // 2)
                feet_y = find_feet_bottom(
                    mask,
                    int(min(foot_xs)) - margin,
                    int(max(foot_xs)) + margin,
                    ankle_y
                )
                if feet_y is None:
                    feet_y = min(h - 1, int(max(left_heel.y, right_heel.y) * h))

                # Head must be fully in the picture (not cut off at the top)
                full_body = 10 < head_top_y < nose_y and 0 < center_x < w

                if full_body:

                    head_px = int(round(head_top_y))
                    # Yellow line + red dots: head top and floor
                    cv2.line(frame, (center_x, head_px), (center_x, feet_y), (0, 255, 255), 3)
                    cv2.circle(frame, (center_x, head_px), 6, (0, 0, 255), -1)
                    cv2.circle(frame, (center_x, min(feet_y, h - 4)), 6, (0, 0, 255), -1)

                    # ---- STANDING LINE CHECK (feet) ----
                    # Uses where the FEET touch the floor (the yellow line's bottom dot),
                    # not the ankles: the floor is at the same height for everyone, while
                    # ankle height changes with body size and shoes.
                    # That bottom dot is the TOES; the check compares the MIDDLE of
                    # the feet (NEW), so big and small feet are judged the same way.
                    ankle_row = float(feet_y)
                    ankle_drop_cm = cam_h_cm

                    if ankle_row < h:
                        ankle_row_history.append(ankle_row)
                        # smooth out frame-to-frame flicker of the outline
                        ankle_row = float(np.median(list(ankle_row_history)[-5:]))

                    angle_down = None
                    if focal_px is not None:
                        # Angle of the head-top pixel below the image center
                        angle_down = tilt_used + np.arctan((head_top_y - cy) / focal_px)
                        # Body height at the footprints' distance: only used to
                        # look up the spot for this body size
                        recent_heights.append(height_at(angle_down, patient_dist_cm))

                    if calibrated and spot_points and recent_heights:
                        if ankle_row >= h - 2:
                            # Feet are below the bottom of the picture:
                            # the patient is standing too close
                            line_offset_cm = -99.0
                        else:
                            toe_dist = point_distance_cm(
                                ankle_row, cy, focal_px, tilt_used, ankle_drop_cm
                            )
                            if toe_dist is not None:
                                body_h = float(np.median(recent_heights))
                                line_offset_cm = (foot_center_cm(toe_dist, body_h)
                                                  - expected_spot_cm(body_h))

                    if angle_down is not None:
                        # Patient's real distance (NEW): footprints distance plus how
                        # far off the footprints they stand (smoothed, within tolerance)
                        head_dist_used = patient_dist_cm
                        if (USE_FEET_FOR_DISTANCE and line_offset_cm is not None
                                and line_offset_cm > -99):
                            offset_history.append(line_offset_cm)
                            off = float(np.clip(np.median(offset_history),
                                                -LINE_TOLERANCE_CM, LINE_TOLERANCE_CM))
                            head_dist_used = patient_dist_cm + off
                        else:
                            offset_history.clear()

                        # Height of the line of sight at the patient's distance
                        def row_cm(row):
                            return height_at(tilt_used + np.arctan((row - cy) / focal_px),
                                             head_dist_used)

                        outline_cm = height_at(angle_down, head_dist_used)
                        top_cm = outline_cm - HEAD_TOP_OFFSET_CM   # remove outline blur
                        hair_cut = False
                        face_ok = all(p.visibility > BODY_VISIBILITY
                                      for p in (left_eye, right_eye, mouth_l, mouth_r))
                        if HAIR_CHECK_ON and face_ok:
                            eye_row = (left_eye.y + right_eye.y) / 2 * h
                            mouth_row = (mouth_l.y + mouth_r.y) / 2 * h
                            if mouth_row > eye_row:
                                eye_cm = row_cm(eye_row)
                                skull_history.append(
                                    eye_cm + SKULL_RATIO * (eye_cm - row_cm(mouth_row)))
                        if HAIR_CHECK_ON and len(skull_history) >= 5:
                            skull_cm = float(np.median(skull_history))
                            if top_cm - skull_cm > HAIR_THRESHOLD_CM:
                                top_cm = skull_cm                   # outline is hair
                                hair_cut = True
                            # show where the program thinks the skull ends (cyan)
                            if ruler is None:
                                t_sk = (cam_h_cm - skull_cm) / head_dist_used
                            else:
                                t_sk = (skull_cm - ruler[0]) / (
                                    ruler[1] * head_dist_used / ref_dist_cm)
                            sky = int(round(cy + focal_px * np.tan(np.arctan(t_sk) - tilt_used)))
                            cv2.line(frame, (center_x - 25, sky), (center_x + 25, sky),
                                     (255, 255, 0), 2)

                        height_raw = top_cm
                        height_now = correct_height(height_raw)

        # ------------------------------------
        # PATIENT STATE + AUTOMATIC MEASUREMENTS
        # ------------------------------------

        if full_body:
            missing_count = 0
            present_count += 1
        else:
            missing_count += 1
            present_count = 0
            height_history.clear(); raw_history.clear()

        # Patient left: get ready for the next one
        if person_seen:
            last_seen_at = time.monotonic()
        # Only a NEW patient (nobody in view for NEW_PATIENT_SEC) hears the welcome again,
        # so a short tracking drop-out doesn't repeat the introduction.
        if time.monotonic() - last_seen_at >= NEW_PATIENT_SEC and greeted:
            ankle_row_history.clear()    # next patient's feet start fresh
            greeted = False
            posture_corrected = False
            measure_announced = False
            remeasures = 0
            spoken_key = None

        if missing_count >= RESET_FRAMES:
            recent_heights.clear()       # next person's body size starts fresh
            skull_history.clear()
            skull_cm = None
            offset_history.clear()
        if missing_count >= RESET_FRAMES and (captures or final_height_cm is not None):
            captures = []
            captures_raw = []
            flash_text = None
            final_height_cm = None
            final_saved = False
            height_history.clear(); raw_history.clear()

        off_line = (
            line_offset_cm is not None
            and abs(line_offset_cm) > LINE_TOLERANCE_CM
        )
        if off_line:
            height_history.clear(); raw_history.clear()     # wait until the patient is back on the footprints
        if posture_bad:
            height_history.clear(); raw_history.clear()     # wait until the patient stands straight (NEW)
        if not_facing:
            height_history.clear(); raw_history.clear()     # wait until they face the camera (NEW)

        measuring = (
            full_body
            and calibrated
            and height_now is not None
            and final_height_cm is None
            and present_count > WARMUP_FRAMES
            and not off_line
            and not posture_bad          # Sanat's posture check (NEW)
            and not not_facing           # facing the camera (NEW)
            and not posture_corrected    # say "Perfect... hold still" first (NEW)
            and measure_announced        # "Now we will take your measurements" was said
            and not voice.busy           # wait until the spoken instructions finish
        )

        pending_shot = None      # screenshot to save after the screen is drawn

        steady = False
        if measuring:
            height_history.append(height_now)
            raw_history.append(height_raw)
            if len(height_history) == STABLE_FRAMES:
                steady = np.std(height_history) < STABLE_TOLERANCE_CM

        if measuring and steady:

            measurement = float(np.median(height_history))
            captures.append(measurement)
            captures_raw.append(float(np.median(raw_history)))
            height_history.clear(); raw_history.clear()     # next capture uses fresh frames

            imp, met = format_height(measurement)
            print(f"Capture {len(captures)}/{CAPTURES_PER_PATIENT}: {imp} / {met}")
            if outline_cm is not None and skull_cm is not None:
                print(f"  outline top {outline_cm:.1f} cm, face-estimated skull top "
                      f"{skull_cm:.1f} cm" + ("  -> hair: using face estimate" if hair_cut
                                              else "  -> using outline"))
            pending_shot = f"height_capture_{len(captures)}"
            if len(captures) < CAPTURES_PER_PATIENT:
                flash_text = [f"{len(captures)} OF {CAPTURES_PER_PATIENT}",
                              "PICTURE TAKEN"]
                flash_until = time.monotonic() + CAPTURE_FLASH_SEC
                # "One." / "Two." so the patient knows how many are left (NEW)
                voice.say(VOICE_AFTER_PICTURE.get(len(captures), ""))

            if len(captures) >= CAPTURES_PER_PATIENT:
                final_height_cm = float(np.median(captures))
                final_raw_cm = float(np.median(captures_raw))
                spread = max(captures) - min(captures)
                imp, met = format_height(final_height_cm)
                print(f"FINAL HEIGHT: {imp} / {met}  (spread {spread:.1f} cm)")
                print(f"  RAW: {final_raw_cm:.1f} cm   <- for KNOWN_HEIGHTS: (true_cm, {final_raw_cm:.1f})"
                      f"   head distance used: {head_dist_used:.1f} cm")
                if spread > MAX_SPREAD_CM and remeasures < MAX_REMEASURES and "MEASURE_AGAIN" in voice.sounds:
                    # "We will take your measurements again." - redo the 3 captures
                    print("  Measurements disagree - measuring again.")
                    remeasures += 1
                    captures = []
                    captures_raw = []
                    final_height_cm = None
                    flash_text = None
                    voice.say("MEASURE_AGAIN")   # "hold still" only if they then move
                else:
                    if spread > MAX_SPREAD_CM:
                        print("  WARNING: measurements disagree - patient may have moved. "
                              "Consider measuring again.")
                    pending_shot = None    # the FINAL screenshot covers the last capture
                    voice.say("SUCCESS_STATION_2")
                    try:
                        with open(LOG_FILE, "a", newline="") as f:
                            csv.writer(f).writerow([
                                datetime.now().isoformat(timespec="seconds"),
                                f"{final_height_cm:.1f}", imp, f"{final_raw_cm:.1f}",
                                " ".join(f"{c:.1f}" for c in captures), f"{spread:.1f}",
                                "" if not offset_history else f"{np.median(offset_history):+.1f}",
                                f"{head_dist_used:.1f}",
                                (f"ruler {ruler_tags} tag(s); " if ruler else "") + correction_text])
                    except OSError as error:
                        print(f"  Could not write the log: {error}")

        # ------------------------------------
        # STAFF INFO PANEL (top left)
        # ------------------------------------

        panel = []                       # (text, color, big?)
        if not focal_history:
            panel.append(("SHOW APRILTAG TO CALIBRATE", (0, 255, 255), True))
        elif not calibrated:
            panel.append((f"CALIBRATING {len(focal_history)}/{MIN_CALIBRATION_FRAMES}",
                          (0, 255, 255), True))
        elif tag_found:
            panel.append((f"TAG OK  tilt (live): {np.degrees(tilt_used):.1f} deg", (0, 255, 255), True))
        else:
            panel.append((f"TAG HIDDEN  tilt (last): {np.degrees(tilt_used):.1f} deg", (0, 165, 255), True))

        if final_height_cm is not None:
            imp, met = format_height(final_height_cm)
            panel.append((f"FINAL: {imp}   {met}", (0, 255, 0), True))
        elif pending_shot is not None:
            imp, met = format_height(captures[-1])
            panel.append((f"Capture {len(captures)}: {imp}   {met}", (0, 255, 0), True))
        elif height_history:
            imp, met = format_height(float(np.median(height_history)))
            panel.append((f"Height: {imp}   {met}", (255, 255, 255), True))

        if captures:
            panel.append(("Captures (cm): " + "  ".join(f"{c:.1f}" for c in captures),
                          (255, 255, 255), False))

        if not spot_points:
            line_text = "Spot: not set - press L"
        elif line_offset_cm is None:
            line_text = f"Spot: set ({len(spot_points)} taught)"
        elif line_offset_cm <= -99:
            line_text = "Spot: set  feet below picture (too close)"
        else:
            line_text = (f"Spot: set ({len(spot_points)})  feet {line_offset_cm:+.1f} cm"
                         f"  dist {head_dist_used:.0f}")
        panel.append((line_text, (0, 255, 255), False))

        if REF_TAGS:
            if ruler is None:
                panel.append(("RULER: tags not seen yet", (0, 165, 255), False))
            else:
                fit_dist = -ruler[1]
                ok = abs(fit_dist / ref_dist_cm - 1) < 0.10 or ruler_tags < 2
                size_dist = ruler_tag_distance_cm(focal_px, tilt_used)
                if size_dist is not None and abs(size_dist - ref_dist_cm) > LINE_TOLERANCE_CM * 2:
                    ok = False
                if ok:
                    panel.append((f"RULER: {ruler_tags} tag(s) OK at {ref_dist_cm:.0f} cm",
                                  (0, 255, 0), False))
                else:
                    where = f"seen at {size_dist:.0f} cm" if size_dist is not None else ""
                    panel.append((f"RULER: CHECK TAGS {where} (set {ref_dist_cm:.0f})",
                                  (0, 0, 255), False))

        if show_panel:
            # size everything from the picture width, so it looks the same at any resolution
            ui = w / 1600.0
            big_s, small_s = max(0.4, 0.75 * ui), max(0.35, 0.6 * ui)
            pad, gap = int(12 * ui) + 4, int(14 * ui) + 6
            sizes = []
            for text, _, big in panel:
                sc = big_s if big else small_s
                th = max(1, int(round(2 * sc)))
                (tw, tht), _ = cv2.getTextSize(text, cv2.FONT_HERSHEY_SIMPLEX, sc, th)
                sizes.append((sc, th, tw, tht))
            box_w = min(w - 10, max(t[2] for t in sizes) + 2 * pad)
            box_h = sum(t[3] for t in sizes) + gap * (len(sizes) - 1) + 2 * pad
            overlay = frame.copy()
            cv2.rectangle(overlay, (5, 5), (5 + box_w, 5 + box_h), (20, 20, 20), -1)
            cv2.addWeighted(overlay, PANEL_OPACITY, frame, 1 - PANEL_OPACITY, 0, dst=frame)
            y = 5 + pad
            for (text, color, _), (sc, th, tw, tht) in zip(panel, sizes):
                y += tht
                cv2.putText(frame, text, (5 + pad, y), cv2.FONT_HERSHEY_SIMPLEX, sc, color, th)
                y += gap

        # ------------------------------------
        # PATIENT INSTRUCTIONS (big banner, bottom)
        # ------------------------------------

        if not calibrated:
            draw_banner(frame, "PLEASE WAIT\nSystem starting up", (0, 255, 255))
        elif final_height_cm is not None:
            imp, _ = format_height(final_height_cm)
            draw_banner(frame, f"DONE!  {imp}\nYou may step off", (0, 255, 0))
        elif not person_seen:
            draw_banner(frame, "STAND ON THE FOOTPRINTS\nFace the camera", (255, 255, 255))
        elif not full_body:
            draw_banner(frame, "STEP BACK ONTO THE FOOTPRINTS\nWhole body in view", (0, 165, 255))
        elif off_line and line_offset_cm < 0:
            draw_banner(frame, "STEP BACK\nFeet on the footprints", (0, 165, 255))
        elif off_line:
            draw_banner(frame, "STEP FORWARD\nFeet on the footprints", (0, 165, 255))
        elif not_facing:
            draw_banner(frame, "FACE THE CAMERA\nStand straight, look ahead", (0, 165, 255))
        elif posture_bad:
            draw_banner(frame, "STAND TALL\n" + posture_issue, (0, 165, 255))
        else:
            n = len(captures) + 1
            progress = len(height_history) / STABLE_FRAMES
            draw_banner(
                frame,
                f"STAND TALL - LOOK AHEAD\nHOLD STILL - PICTURE {n} OF {CAPTURES_PER_PATIENT}",
                (255, 255, 255)
            )
            # Progress bar for the current measurement
            bar_y = h - 8
            cv2.rectangle(frame, (0, bar_y - 6), (int(w * progress), bar_y), (0, 255, 0), -1)

            # Countdown to the next picture (NEW)
            if SHOW_COUNTDOWN and time.monotonic() >= flash_until:
                if measuring:
                    frames_left = STABLE_FRAMES - len(height_history)
                    if frames_left > 0:
                        secs = int(np.ceil(frames_left / max(fps_est, 1.0)))
                        draw_center_text(frame, [str(secs), f"PICTURE {n} OF {CAPTURES_PER_PATIENT}"],
                                         (0, 255, 255))
                    else:
                        # enough frames, but the patient is still moving
                        draw_center_text(frame, ["HOLD STILL", f"PICTURE {n} OF {CAPTURES_PER_PATIENT}"],
                                         (0, 165, 255), size=0.45)
                elif measure_announced or voice.busy:
                    draw_center_text(frame, ["GET READY", f"PICTURE {n} OF {CAPTURES_PER_PATIENT}"],
                                     (255, 255, 255), size=0.45)

        # "PICTURE 1 OF 3 TAKEN" flash after each capture (NEW)
        if (SHOW_COUNTDOWN and flash_text and time.monotonic() < flash_until
                and final_height_cm is None):
            draw_center_text(frame, flash_text, (0, 255, 0), size=0.6)

        # ------------------------------------
        # VOICE PROMPTS (NEW): say the banner out loud
        # ------------------------------------
        now = time.monotonic()

        if not calibrated or not person_seen or final_height_cm is not None:
            key = None
        elif not full_body:
            key = "STEP BACK ONTO THE FOOTPRINTS"
        elif off_line and line_offset_cm < 0:
            key = "STEP BACK"
        elif off_line:
            key = "STEP FORWARD"
        elif not_facing:
            key = "FACE THE CAMERA"
        elif posture_bad:
            key = "POSTURE:" + posture_issue
        else:
            key = "HOLD STILL"

        if key != banner_key:
            banner_key, banner_since = key, now

        if person_seen and calibrated and not greeted:
            if not spot_points:
                # spot not taught: the program can't tell if they're off, so say it once
                voice.say(*GREETING, "STAND_ON_FOOTPRINTS")
                spoken_key, spoken_at = "STEP BACK ONTO THE FOOTPRINTS", now
            else:
                voice.say(*GREETING)           # footprints only said if they're off them
                spoken_key = None
            greeted = True
        elif key is not None and not voice.busy and now - banner_since >= BANNER_HOLD_SEC:
            if key == "HOLD STILL":
                if not measure_announced:
                    if posture_corrected and "PERFECT" in voice.sounds:
                        # posture was just fixed: confirm it, then explain the pictures
                        voice.say("PERFECT", *MEASURING_START)
                    else:
                        voice.say(*MEASURING_START)
                    posture_corrected = False
                    measure_announced = True
                    hold_still_at = now
                elif posture_corrected:
                    # only after a posture prompt: praise + hold still (one clip)
                    voice.say("PERFECT" if "PERFECT" in voice.sounds else "HOLD_STILL")
                    posture_corrected = False
                    hold_still_at = now
                elif (len(height_history) == STABLE_FRAMES and not steady
                      and now - hold_still_at >= HOLD_STILL_REPEAT_SEC):
                    voice.say("HOLD_STILL")    # moving too much to measure
                    hold_still_at = now
            elif key.startswith("POSTURE:"):
                if key != spoken_key or now - spoken_at >= REPEAT_SEC:
                    clips = VOICE_FOR_POSTURE.get(key[len("POSTURE:"):], [])
                    if not all(c in voice.sounds for c in clips) or not clips:
                        clips = ["STAND_STRAIGHT"]       # fallback until the new clips exist
                    voice.say(*clips)
                    spoken_key, spoken_at = key, now
                    posture_corrected = True
            elif key != spoken_key or now - spoken_at >= REPEAT_SEC:
                voice.say(*VOICE_FOR_BANNER[key])
                spoken_key, spoken_at = key, now
        # (Corrections no longer cut into the welcome. They wait until it finishes,
        #  and by then most people have already stepped onto the footprints.)

        voice.update()

        # Save screenshots now that the panel and banner are drawn
        if pending_shot is not None:
            shot = save_screenshot(frame, pending_shot)
            print(f"  saved: {shot}")

        # Save one final screenshot with the result banner on it
        if final_height_cm is not None and not final_saved:
            shot = save_screenshot(frame, "height_FINAL")
            print(f"Final screenshot saved: {shot}")
            final_saved = True

        # ------------------------------------
        # CAMERA WINDOW
        # ------------------------------------

        cv2.imshow(WINDOW_NAME, frame)

        key = cv2.waitKey(1) & 0xFF

        if key in (ord("q"), ord("Q")):
            break

        elif key in (ord("f"), ord("F")):
            fullscreen = not fullscreen
            cv2.setWindowProperty(WINDOW_NAME, cv2.WND_PROP_FULLSCREEN,
                                  cv2.WINDOW_FULLSCREEN if fullscreen else cv2.WINDOW_NORMAL)

        elif key in (ord("h"), ord("H")):
            show_panel = not show_panel

        elif key in (ord("c"), ord("C")):
            focal_history.clear()
            tilt_history.clear()
            ever_calibrated = False
            print("Recalibrating: keep the booth empty so the AprilTag is visible.")

        elif key in (ord("l"), ord("L")):
            if not calibrated:
                print("Can't set the spot yet: wait until the AprilTag calibration finishes.")
            elif len(ankle_row_history) < 5:
                print("Can't set the spot: stand on the footprints with your ankles clearly visible.")
            else:
                taught = point_distance_cm(
                    float(np.median(ankle_row_history)), cy, focal_px, tilt_used,
                    cam_h_cm
                )
                if taught is None:
                    print("Can't set the spot: feet not clearly in view.")
                elif len(recent_heights) < 5:
                    print("Can't set the spot: stand so your whole body (head too) is in view.")
                else:
                    body_h = float(np.median(recent_heights))
                    center = foot_center_cm(taught, body_h)
                    # Same-size person again? Replace their spot instead of adding one
                    spot_points[:] = [p for p in spot_points
                                      if abs(p[0] - body_h) >= SPOT_MIN_HEIGHT_GAP_CM]
                    spot_points.append((body_h, center))
                    offset_history.clear()

        elif key in (ord("k"), ord("K")):
            spot_points.clear()
            offset_history.clear()
            print("Standing spots forgotten - press L to teach again.")

        elif key in (ord("p"), ord("P")):
            if posture.set_baseline():
                print("Posture reference set from the current posture.")
            else:
                print("Can't set posture reference yet - stand in view for a moment first.")

        elif key in (ord("s"), ord("S")):
            shot = save_screenshot(frame, "manual_capture")
            print(f"Manual screenshot saved: {shot}")

finally:
    voice.stop()
    cap.release()
    pose.close()
    cv2.destroyAllWindows()
