def ruler_fit(focal, tilt, center_y):
    """Fit height = a + b * tan(angle down) through the ruler tags.
    Returns ((a, b), number of tags used) or (None, 0)."""
    pts = []
    for tid, rows in ref_rows.items():
        if len(rows) >= 5:
            t = np.tan(tilt + np.arctan((np.median(rows) - center_y) / focal))
            pts.append((t, REF_TAGS[tid]))
    if not pts:
        return None, 0
    ts = np.array([p[0] for p in pts])
    hs = np.array([p[1] for p in pts])
    if len(pts) == 1 or ts.max() - ts.min() < 1e-3:
        # one tag: it fixes the height level, the booth distance gives the scale
        b = -ref_dist_cm
        a = float(np.mean(hs - b * ts))
        return (a, b), len(pts)
    b, a = np.polyfit(ts, hs, 1)
    return (float(a), float(b)), len(pts)


def ruler_tag_distance_cm(focal, tilt):
    """How far away the ruler tags really are (from their printed size),
    straight ahead along the floor. Used only as a placement check."""
    dists = []
    for tid, widths in ref_widths.items():
        if len(widths) >= 5:
            depth = focal * RULER_TAG_WIDTH_CM / float(np.median(widths))
            drop = cam_h_cm - REF_TAGS[tid]
            dists.append((depth - drop * np.sin(tilt)) / np.cos(tilt))
    return float(np.median(dists)) if dists else None


def height_at(angle_down, dist_cm):
    """Height (cm) of the line of sight at this distance from the camera."""
    t = np.tan(angle_down)
    if ruler is None:
        return cam_h_cm - dist_cm * t
    a, b = ruler
    # the ruler is at ref_dist_cm; scale for a patient a little nearer/farther
    return a + b * t * (dist_cm / ref_dist_cm)


def expected_spot_cm(body_h_cm):
    """Where the middle of the feet should be for someone this tall."""
    hs = np.array([p[0] for p in spot_points])
    cs = np.array([p[1] for p in spot_points])
    if len(spot_points) == 1 or hs.max() - hs.min() < SPOT_MIN_HEIGHT_GAP_CM:
        return float(np.median(cs))
    slope, intercept = np.polyfit(hs, cs, 1)
    # don't extrapolate wildly past the people who taught it
    body_h_cm = float(np.clip(body_h_cm, hs.min() - 25, hs.max() + 25))
    return float(slope * body_h_cm + intercept)

