class VoicePrompts:
    """Plays the recorded prompts one after another without freezing the video."""

    def __init__(self):
        self.sounds = {}
        self.queue = deque()
        self.channel = None
        self.current = None      # clip playing now (NEW)
        if not VOICE_ON or pygame is None:
            print("Voice prompts off (pygame not installed or VOICE_ON = False).")
            return
        try:
            pygame.mixer.init(frequency=44100, size=-16, channels=1)
            freq, fmt, chans = pygame.mixer.get_init()
            frame_bytes = abs(fmt) // 8 * chans
            loaded = {}                  # audio file -> raw samples (each file read once)
            for name, (file_name, start, end) in VOICES[VOICE].items():
                if file_name not in loaded:
                    path = HERE / file_name
                    if path.exists():
                        loaded[file_name] = pygame.mixer.Sound(str(path)).get_raw()
                    else:
                        loaded[file_name] = None
                        print(f"Voice: {file_name} not found next to this program.")
                raw = loaded[file_name]
                if raw is None:
                    continue
                a = int(max(0.0, start - 0.05) * freq) * frame_bytes
                b = min(len(raw), int((end + 0.12) * freq) * frame_bytes)
                self.sounds[name] = pygame.mixer.Sound(buffer=raw[a:b])
            # clips without a recording in this voice use a stand-in
            for name, stand_in in CLIP_STAND_INS.items():
                if name not in self.sounds and stand_in in self.sounds:
                    self.sounds[name] = self.sounds[stand_in]
            print(f"Voice prompts ready: {len(self.sounds)} clips ({VOICE}).")
        except Exception as error:
            print(f"Voice prompts off ({error}).")
            self.sounds = {}

    def say(self, *names):
        for name in names:
            if name in self.sounds:
                self.queue.append(name)

    def say_next(self, *names):
        """Say these right after the clip that is playing now (before the rest of the queue)."""
        for name in reversed(names):
            if name in self.sounds and name not in self.queue:
                self.queue.appendleft(name)

    def stop(self):
        self.queue.clear()
        if self.channel is not None:
            self.channel.stop()

    @property
    def playing(self):
        return self.channel is not None and self.channel.get_busy()

    @property
    def busy(self):
        # "One"/"Two" don't count as busy, so they never pause the measurement (NEW)
        if any(name not in NON_BLOCKING_CLIPS for name in self.queue):
            return True
        return self.playing and self.current not in NON_BLOCKING_CLIPS

    def update(self):
        if self.queue and not self.playing:
            name = self.queue.popleft()
            print(f"  [voice] {name}")
            self.current = name
            self.channel = self.sounds[name].play()

