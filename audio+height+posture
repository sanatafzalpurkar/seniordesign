class VoicePrompts:
    """Plays the recorded prompts one after another without freezing the video."""

    def __init__(self):
        self.sounds = {}
        self.queue = deque()
        self.channel = None
        if not VOICE_ON or pygame is None:
            print("Voice prompts off (pygame not installed or VOICE_ON = False).")
            return
        cfg = VOICES[VOICE]
        try:
            pygame.mixer.init(frequency=44100, size=-16, channels=1)
            freq, fmt, chans = pygame.mixer.get_init()
            frame_bytes = abs(fmt) // 8 * chans
            audio = HERE / cfg["audio"]
            if audio.exists():
                full = pygame.mixer.Sound(str(audio))
                raw = full.get_raw()
                for name, (start, end) in cfg["clips"].items():
                    a = int(max(0.0, start - 0.05) * freq) * frame_bytes
                    b = int((end + 0.12) * freq) * frame_bytes
                    self.sounds[name] = pygame.mixer.Sound(buffer=raw[a:b])
            else:
                print(f"Voice: {audio.name} not found next to this program.")
            for name, file_name in NEW_CLIPS.items():
                path = HERE / cfg["new_clips_folder"] / file_name
                if not path.exists():
                    path = HERE / file_name
                if path.exists():
                    self.sounds[name] = pygame.mixer.Sound(str(path))
                else:
                    print(f"Voice: {file_name} not found - skipped.")
            print(f"Voice prompts ready: {len(self.sounds)} clips ({VOICE}).")
        except Exception as error:
            print(f"Voice prompts off ({error}).")
            self.sounds = {}

    def say(self, *names):
        for name in names:
            if name in self.sounds:
                self.queue.append(name)

    def say_next(self, *names):
        """Say these right after the clip that is playing now (before the rest of the queue)."""
        for name in reversed(names):
            if name in self.sounds and name not in self.queue:
                self.queue.appendleft(name)

    def stop(self):
        self.queue.clear()
        if self.channel is not None:
            self.channel.stop()

    @property
    def busy(self):
        return bool(self.queue) or (self.channel is not None and self.channel.get_busy())

    def update(self):
        if self.queue and not (self.channel is not None and self.channel.get_busy()):
            name = self.queue.popleft()
            print(f"  [voice] {name}")
            self.channel = self.sounds[name].play()

