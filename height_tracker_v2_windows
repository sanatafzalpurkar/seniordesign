import os
import sys

# Speeds up MSMF camera startup on Windows (must be set before importing cv2)
os.environ["OPENCV_VIDEOIO_MSMF_ENABLE_HW_TRANSFORMS"] = "0"

import cv2
import numpy as np
import mediapipe as mp
from collections import deque
from pathlib import Path
from datetime import datetime

# ============================================
# PREV-HUB AUTOMATIC HEIGHT TRACKER
# Python 3.11.9 - Webcam Prototype (Windows / macOS / Linux)
# Runs by itself: patient steps on the line, holds still,
# the program takes several measurements and shows the result.
#
# Install:
#   pip uninstall -y opencv-python opencv-contrib-python
#   pip install opencv-contrib-python mediapipe==0.10.14 numpy
# ============================================

CAMERA_INDEX = 0

# Requested capture resolution (the camera uses the closest it supports).
REQUEST_WIDTH = 1280
REQUEST_HEIGHT = 720

# Laptop webcam is already upright -> None.
# If the camera is mounted sideways (booth), use:
#   cv2.ROTATE_90_CLOCKWISE or cv2.ROTATE_90_COUNTERCLOCKWISE
# If you appear upside down, switch to the other direction.
ROTATE = None

# --------------------------------------------
# BOOTH GEOMETRY  (ALL IN CENTIMETERS - measure with a tape measure)
# --------------------------------------------
# Distances are HORIZONTAL, along the floor, from the camera lens.
# Heights are measured straight up from the floor.
# (inches x 2.54 = cm,  feet x 30.48 = cm)
#
#   NOW (MacBook test):  camera 112 cm, patient line 164.6 cm, tag 442 cm
#   LATER (booth):       camera 198.1 cm (6.5 ft) high, tilted ~27.5 deg down,
#                        patient 106.7 cm (3.5 ft) away,
#                        tag 213.4 cm (7 ft) away
#
# NOTE: these numbers are from the Mac test. Re-measure them for your
# Windows laptop setup or the height will be off.

CAMERA_HEIGHT_CM = 112.0         # floor -> camera lens          (later: 198.1)
CAMERA_TILT_DEG = 0.0            # downward tilt, 0 = level      (later: 27.5)
                                 # (only a starting guess when AUTO_TILT = True)
AUTO_TILT = True                 # measure the tilt from the AprilTag automatically
PATIENT_DISTANCE_CM = 164.6      # camera -> where patient stands (later: 106.7)
TAG_DISTANCE_CM = 442.0          # camera -> wall with the tag    (later: 213.4)
TAG_CENTER_HEIGHT_CM = 131.0     # floor -> CENTER of the tag (measure it!)

# AprilTag settings
# Measure the outer BLACK square with a ruler. Printers often stretch
# the tag slightly, so measure both directions as it hangs on the wall.
TAG_WIDTH_CM = 16.0              # left-right (horizontal on the wall)
TAG_HEIGHT_CM = 16.5             # top-bottom (vertical on the wall)
TAG_ID = 0

# LIVE calibration: every frame the tag is visible, the tilt and zoom are
# re-measured (median of the last 60 readings), so a change in camera tilt
# is picked up automatically, even while a patient is being measured.
# If the tag is hidden, the last readings are kept.
CALIBRATION_FRAMES = 60          # rolling window of tag readings
MIN_CALIBRATION_FRAMES = 30      # readings needed before measuring starts
# If the newest readings show the camera clearly changed (tilt or zoom),
# older readings are dropped so the program catches up right away.
CHANGE_TILT_DEG = 0.3
CHANGE_FOCAL_PCT = 2.0

# Fine-tune after testing with people of known height
CALIBRATION_FACTOR = 1.0         # multiply (true / shown, if off by a %)
HEIGHT_OFFSET_CM = 0.0           # add/subtract (if always off by same cm)

# --------------------------------------------
# PERSON DETECTION
# --------------------------------------------
# 0 = fast, 1 = balanced, 2 = most accurate (best marker feet/ankles).
# The first run with 2 downloads a bigger model (needs internet once).
# If the video becomes laggy, change to 1.
MODEL_COMPLEXITY = 2

# How sure MediaPipe must be that a body part is visible (0-1).
# Ankles use a lower bar: shoes and the bottom edge of the frame
# often make them uncertain, and the height math doesn't use the feet.
BODY_VISIBILITY = 0.5
ANKLE_VISIBILITY = 0.3

# --------------------------------------------
# AUTOMATIC MEASUREMENT
# --------------------------------------------
WARMUP_FRAMES = 15               # ignore the first frames after someone steps in
                                 #   (tracking is still settling)
STABLE_FRAMES = 30               # frames averaged for ONE measurement
STABLE_TOLERANCE_CM = 1.0        # height must stay within this spread to count as "still"
CAPTURES_PER_PATIENT = 3         # measurements taken per patient (final = median)
MAX_SPREAD_CM = 2.5              # warn if the measurements disagree more than this
RESET_FRAMES = 20                # frames with nobody in view before the next patient

# --------------------------------------------
# STANDING LINE CHECK  (press L to teach the footprints)
# --------------------------------------------
# During setup, stand on the footprints and press L. The program remembers
# that spot and asks patients to step back/forward if they're off it.
# Not used in the height calculation (that still uses PATIENT_DISTANCE_CM).
# The check uses the ANKLES: a front-facing camera can't see the heels,
# and the toes drop below the bottom of the picture first.
LINE_TOLERANCE_CM = 8.0          # how far off the footprints is still OK
ANKLE_HEIGHT_CM = 8.0            # approx. height of the ankle bone above the floor

# Where screenshots will be saved
SAVE_FOLDER = Path.home() / "Downloads" / "PrevHub_Captures"
SAVE_FOLDER.mkdir(parents=True, exist_ok=True)

WINDOW_NAME = "PREV-HUB Automatic Height Tracker"

# ============================================
# INITIALIZE MEDIAPIPE
# ============================================

mp_pose = mp.solutions.pose
mp_drawing = mp.solutions.drawing_utils

pose = mp_pose.Pose(
    static_image_mode=False,
    model_complexity=MODEL_COMPLEXITY,
    min_detection_confidence=0.5,
    min_tracking_confidence=0.5,
    enable_segmentation=True,      # person outline, used to find the real top of head
    smooth_segmentation=True
)

# Segmentation mask threshold (0-1). Higher = tighter outline.
MASK_THRESHOLD = 0.5


def open_camera(index):
    """Open the camera with the right backend for this OS.
    On Windows tries DirectShow first, then Media Foundation."""
    if sys.platform == "darwin":
        backends = [cv2.CAP_AVFOUNDATION]
    elif sys.platform == "win32":
        backends = [cv2.CAP_DSHOW, cv2.CAP_MSMF]
    else:
        backends = [cv2.CAP_V4L2, cv2.CAP_ANY]

    for backend in backends:
        cap = cv2.VideoCapture(index, backend)
        if cap.isOpened():
            # Request resolution (MJPG first: many webcams only offer
            # HD+ over MJPG, otherwise Windows falls back to 640x480)
            cap.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc(*"MJPG"))
            cap.set(cv2.CAP_PROP_FRAME_WIDTH, REQUEST_WIDTH)
            cap.set(cv2.CAP_PROP_FRAME_HEIGHT, REQUEST_HEIGHT)
            ok, _ = cap.read()
            if ok:
                return cap
        cap.release()
    return None


def format_height(height_cm):
    """Return the height as (imperial text, metric text)."""
    total_inches = height_cm / 2.54
    feet = int(total_inches // 12)
    inches = total_inches - feet * 12
    if inches >= 11.95:          # avoid showing "4 ft 12.0 in"
        feet += 1
        inches = 0.0
    imperial = f"{feet} ft {inches:.1f} in"
    metric = f"{height_cm:.1f} cm ({height_cm / 100:.2f} m)"
    return imperial, metric


def find_head_top(mask, x_center, half_width, start_y):
    """Scan UP from start_y (nose) inside a narrow column until the
    person outline ends. Returns the y of the top of the head/hair,
    or None if the mask is unavailable."""
    if mask is None or start_y <= 0:
        return None
    mh, mw = mask.shape[:2]
    x0 = max(0, x_center - half_width)
    x1 = min(mw, x_center + half_width)
    if x1 <= x0:
        return None
    counts = (mask[:start_y, x0:x1] > MASK_THRESHOLD).sum(axis=1)
    min_px = max(3, int((x1 - x0) * 0.15))
    gaps = np.where(counts < min_px)[0]
    return int(gaps[-1] + 1) if len(gaps) else 0


def find_feet_bottom(mask, x0, x1, start_y):
    """Scan DOWN from start_y (ankles) until the person outline ends.
    Returns the y where the feet touch the floor (display only)."""
    if mask is None:
        return None
    mh, mw = mask.shape[:2]
    x0 = max(0, x0)
    x1 = min(mw, x1)
    if x1 <= x0 or start_y >= mh:
        return None
    counts = (mask[start_y:, x0:x1] > MASK_THRESHOLD).sum(axis=1)
    min_px = max(3, int((x1 - x0) * 0.05))
    gaps = np.where(counts < min_px)[0]
    return int(start_y + gaps[0] - 1) if len(gaps) else mh - 1


def draw_banner(frame, text, color):
    """Big instruction banner along the bottom of the screen for the patient."""
    h, w = frame.shape[:2]
    scale = max(0.8, w / 900)
    thickness = max(2, int(scale * 2))
    lines = text.split("\n")
    line_h = int(45 * scale)
    top = h - line_h * len(lines) - 30
    cv2.rectangle(frame, (0, top - 10), (w, h), (25, 25, 25), -1)
    for i, line in enumerate(lines):
        (tw, _), _ = cv2.getTextSize(line, cv2.FONT_HERSHEY_SIMPLEX, scale, thickness)
        x = max(10, (w - tw) // 2)
        y = top + line_h * (i + 1) - 10
        cv2.putText(frame, line, (x, y), cv2.FONT_HERSHEY_SIMPLEX,
                    scale, color, thickness)


def point_distance_cm(row, cy, focal_px, tilt, drop_cm):
    """Horizontal distance (cm) from the camera to a point seen at this image
    row that sits drop_cm below the camera lens. Used only for the
    standing-line check (not for the height). Uses the LIVE tilt."""
    angle_down = tilt + np.arctan((row - cy) / focal_px)
    if angle_down <= np.radians(1.0):      # at/above the horizon: not usable
        return None
    return drop_cm / np.tan(angle_down)


def save_screenshot(frame, name):
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    filename = SAVE_FOLDER / f"{name}_{timestamp}.png"
    return filename if cv2.imwrite(str(filename), frame) else None

# ============================================
# INITIALIZE APRILTAG DETECTOR
# ============================================

aruco = getattr(cv2, "aruco", None)

if aruco is not None:
    dictionary = aruco.getPredefinedDictionary(
        aruco.DICT_APRILTAG_36h11
    )

    parameters = aruco.DetectorParameters()
    detector = aruco.ArucoDetector(
        dictionary, parameters
    )

    print("AprilTag detection enabled.")
else:
    detector = None
    print("AprilTag unavailable (install opencv-contrib-python). Pixel tracking only.")

# ============================================
# OPEN CAMERA
# ============================================

cap = open_camera(CAMERA_INDEX)

if cap is None:
    print(f"ERROR: Camera index {CAMERA_INDEX} could not be opened.")
    print("Try CAMERA_INDEX = 1 or 2, and close any app using the camera.")
    pose.close()
    raise SystemExit

print("Resolution:", int(cap.get(cv2.CAP_PROP_FRAME_WIDTH)), "x",
      int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT)))
print("PREV-HUB HEIGHT TRACKER STARTED")
print("Keep the AprilTag in view: the tilt is measured live from it.")
print("Keys (click the camera window first):")
print("  L = set standing spot (stand on the footprints, then press L)")
print("  S = manual screenshot   C = recalibrate   Q = quit")

# Resizable window that keeps the picture's shape
cv2.namedWindow(WINDOW_NAME, cv2.WINDOW_NORMAL | cv2.WINDOW_KEEPRATIO)

# ============================================
# TRACKING VARIABLES
# ============================================

focal_history = deque(maxlen=CALIBRATION_FRAMES)
tilt_history = deque(maxlen=CALIBRATION_FRAMES)
height_history = deque(maxlen=STABLE_FRAMES)

# Everything below works in centimeters (angles in radians)
cam_h_cm = CAMERA_HEIGHT_CM
tilt_rad = np.radians(CAMERA_TILT_DEG)
patient_dist_cm = PATIENT_DISTANCE_CM
tag_dist_cm = TAG_DISTANCE_CM
tag_h_cm = TAG_CENTER_HEIGHT_CM

present_count = 0        # frames the current patient has been in view
missing_count = RESET_FRAMES
captures = []            # measurements for the current patient (cm)
final_height_cm = None   # result once all captures are done
final_saved = False      # final screenshot already written for this patient
ever_calibrated = False  # True once the first MIN_CALIBRATION_FRAMES readings are in

ankle_row_history = deque(maxlen=15)  # recent ankle rows, for teaching the spot
line_distance_cm = None               # taught standing spot (cm from camera)

# ============================================
# MAIN CAMERA LOOP
# ============================================

try:
    while True:

        ret, frame = cap.read()

        if not ret:
            print("Could not read camera frame.")
            break

        # Rotate vertically mounted camera upright
        if ROTATE is not None:
            frame = cv2.rotate(frame, ROTATE)

        h, w = frame.shape[:2]
        cy = h / 2.0

        # ------------------------------------
        # DETECT APRILTAG
        # Must run on the UNMIRRORED frame: a mirrored
        # AprilTag decodes as an invalid code, so
        # detectMarkers() always returns None.
        # ------------------------------------

        tag_found = False
        tag_pts = None

        if detector is not None:

            gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)

            corners, ids, rejected = detector.detectMarkers(gray)

            if ids is not None:

                for i, marker_id in enumerate(ids.flatten()):

                    if marker_id != TAG_ID:
                        continue

                    pts = corners[i].reshape(4, 2).copy()

                    # Use the two most HORIZONTAL edges: a downward tilt
                    # shrinks the vertical edges but not the horizontal ones
                    edges = [pts[(j + 1) % 4] - pts[j] for j in range(4)]
                    horiz = [
                        np.linalg.norm(e) for e in edges
                        if abs(e[0]) >= abs(e[1])
                    ]
                    if len(horiz) == 0:
                        horiz = [np.linalg.norm(e) for e in edges]
                    tag_width_px = float(np.mean(horiz))

                    if tag_width_px > 5:

                        tag_center_y = float(pts[:, 1].mean())

                        # Angle from the camera down to the tag center,
                        # known from the measured booth geometry
                        tag_drop_cm = cam_h_cm - tag_h_cm
                        tag_angle = np.arctan(tag_drop_cm / tag_dist_cm)

                        # Solve tilt and focal length together (they depend
                        # on each other, so repeat until they settle)
                        tilt_est = tilt_rad
                        for _ in range(10):
                            tag_z_cm = (
                                tag_dist_cm * np.cos(tilt_est)
                                + tag_drop_cm * np.sin(tilt_est)
                            )
                            # Focal length in pixels: tag width = f * width / depth.
                            # Uses the HORIZONTAL edges, so it must use the
                            # real left-right width of the printed tag.
                            f_est = tag_width_px * tag_z_cm / TAG_WIDTH_CM

                            if not AUTO_TILT:
                                break

                            # Tilt = (angle down to tag) - (tag's angle
                            # below the image center)
                            tilt_est = tag_angle - np.arctan(
                                (tag_center_y - cy) / f_est
                            )

                        # Keep updating: the newest readings replace the oldest
                        focal_history.append(f_est)
                        tilt_history.append(tilt_est)

                        # Camera clearly changed? Keep only the newest readings
                        if len(tilt_history) >= 20:
                            new_tilt = np.median(list(tilt_history)[-10:])
                            new_focal = np.median(list(focal_history)[-10:])
                            tilt_jump = abs(np.degrees(new_tilt - np.median(tilt_history)))
                            focal_jump = abs(new_focal / np.median(focal_history) - 1) * 100
                            if tilt_jump > CHANGE_TILT_DEG or focal_jump > CHANGE_FOCAL_PCT:
                                keep_t = list(tilt_history)[-10:]
                                keep_f = list(focal_history)[-10:]
                                tilt_history.clear(); tilt_history.extend(keep_t)
                                focal_history.clear(); focal_history.extend(keep_f)
                                print(f"Camera change detected (tilt {tilt_jump:.2f} deg, "
                                      f"zoom {focal_jump:.1f}%) - updated.")

                        tag_found = True

                        # Convert corners to mirrored-frame
                        # coordinates for drawing
                        pts[:, 0] = (w - 1) - pts[:, 0]
                        tag_pts = pts

                        break

        # Camera focal length (pixels) and tilt, from the most recent tag
        # readings. Updated live whenever the tag is visible; if the tag is
        # hidden, the last readings are kept.
        focal_px = float(np.median(focal_history)) if focal_history else None
        if len(focal_history) >= MIN_CALIBRATION_FRAMES:
            ever_calibrated = True
        calibrated = ever_calibrated and bool(focal_history)

        # Camera tilt: measured from the tag (AUTO_TILT) or typed in
        if AUTO_TILT and tilt_history:
            tilt_used = float(np.median(tilt_history))
        else:
            tilt_used = tilt_rad

        # Mirror webcam AFTER tag detection
        # (display, MediaPipe and screenshots stay mirrored)
        frame = cv2.flip(frame, 1)

        if tag_pts is not None:
            cv2.polylines(frame, [tag_pts.astype(np.int32)], True, (255, 0, 255), 2)

        # ------------------------------------
        # DETECT BODY
        # ------------------------------------

        rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
        results = pose.process(rgb)

        person_seen = results.pose_landmarks is not None
        full_body = False
        height_now = None
        line_offset_cm = None    # + = behind the footprints, - = in front of them

        if person_seen:

            landmarks = results.pose_landmarks.landmark

            mp_drawing.draw_landmarks(
                frame,
                results.pose_landmarks,
                mp_pose.POSE_CONNECTIONS
            )

            L = mp_pose.PoseLandmark
            nose = landmarks[L.NOSE]
            left_ear, right_ear = landmarks[L.LEFT_EAR], landmarks[L.RIGHT_EAR]
            left_shoulder, right_shoulder = landmarks[L.LEFT_SHOULDER], landmarks[L.RIGHT_SHOULDER]
            left_ankle, right_ankle = landmarks[L.LEFT_ANKLE], landmarks[L.RIGHT_ANKLE]
            left_heel, right_heel = landmarks[L.LEFT_HEEL], landmarks[L.RIGHT_HEEL]
            left_toe, right_toe = landmarks[L.LEFT_FOOT_INDEX], landmarks[L.RIGHT_FOOT_INDEX]

            # The height math only uses the HEAD, so the feet only need to be
            # roughly visible (to confirm the patient is standing in place).
            upper_ok = all(
                p.visibility > BODY_VISIBILITY
                for p in (nose, left_shoulder, right_shoulder)
            )
            ankles_ok = all(
                p.visibility > ANKLE_VISIBILITY
                for p in (left_ankle, right_ankle)
            )

            if upper_ok and ankles_ok:

                nose_y = int(nose.y * h)
                ankle_y = int(max(left_ankle.y, right_ankle.y) * h)

                # Head center = midpoint between the ears
                center_x = int((left_ear.x + right_ear.x) / 2 * w)
                ear_span = int(abs(left_ear.x - right_ear.x) * w)

                mask = results.segmentation_mask

                # ---- TOP OF HEAD from the person outline ----
                head_top_y = find_head_top(
                    mask, center_x, max(8, ear_span // 4), nose_y
                )
                if head_top_y is None:
                    # Fallback estimate from the nose-to-ankle distance
                    head_top_y = int(nose_y - (ankle_y - nose_y) * 0.15)

                # ---- FEET (display only) ----
                foot_xs = [
                    p.x * w for p in
                    (left_heel, right_heel, left_toe, right_toe,
                     left_ankle, right_ankle)
                ]
                margin = max(10, ear_span // 2)
                feet_y = find_feet_bottom(
                    mask,
                    int(min(foot_xs)) - margin,
                    int(max(foot_xs)) + margin,
                    ankle_y
                )
                if feet_y is None:
                    feet_y = min(h - 1, int(max(left_heel.y, right_heel.y) * h))

                # Head must be fully in the picture (not cut off at the top)
                full_body = 10 < head_top_y < nose_y and 0 < center_x < w

                if full_body:

                    # Yellow line + red dots: head top and floor
                    cv2.line(frame, (center_x, head_top_y), (center_x, feet_y), (0, 255, 255), 3)
                    cv2.circle(frame, (center_x, head_top_y), 6, (0, 0, 255), -1)
                    cv2.circle(frame, (center_x, min(feet_y, h - 4)), 6, (0, 0, 255), -1)

                    # ---- STANDING LINE CHECK (ankles) ----
                    # The spot is taught standing on the footprints, so the
                    # remembered ankle position already includes the
                    # ankle-to-mid-foot distance.
                    ankle_row = (left_ankle.y + right_ankle.y) / 2 * h
                    ankle_drop_cm = cam_h_cm - ANKLE_HEIGHT_CM

                    if ankle_row < h:
                        ankle_row_history.append(ankle_row)

                    if calibrated and line_distance_cm is not None:
                        if ankle_row >= h - 2:
                            # Ankles are below the bottom of the picture:
                            # the patient is standing too close
                            line_offset_cm = -99.0
                        else:
                            ankle_dist = point_distance_cm(
                                ankle_row, cy, focal_px, tilt_used, ankle_drop_cm
                            )
                            if ankle_dist is not None:
                                line_offset_cm = ankle_dist - line_distance_cm

                    if focal_px is not None:
                        # Angle of the head-top pixel below the image center
                        angle_down = tilt_used + np.arctan((head_top_y - cy) / focal_px)

                        # Height of the line of sight at the patient's distance
                        height_now = (
                            cam_h_cm - patient_dist_cm * np.tan(angle_down)
                        ) * CALIBRATION_FACTOR + HEIGHT_OFFSET_CM

        # ------------------------------------
        # PATIENT STATE + AUTOMATIC MEASUREMENTS
        # ------------------------------------

        if full_body:
            missing_count = 0
            present_count += 1
        else:
            missing_count += 1
            present_count = 0
            height_history.clear()

        # Patient left: get ready for the next one
        if missing_count >= RESET_FRAMES and (captures or final_height_cm is not None):
            captures = []
            final_height_cm = None
            final_saved = False
            height_history.clear()

        off_line = (
            line_offset_cm is not None
            and abs(line_offset_cm) > LINE_TOLERANCE_CM
        )
        if off_line:
            height_history.clear()     # wait until the patient is back on the footprints

        measuring = (
            full_body
            and calibrated
            and height_now is not None
            and final_height_cm is None
            and present_count > WARMUP_FRAMES
            and not off_line
        )

        pending_shot = None      # screenshot to save after the screen is drawn

        steady = False
        if measuring:
            height_history.append(height_now)
            if len(height_history) == STABLE_FRAMES:
                steady = np.std(height_history) < STABLE_TOLERANCE_CM

        if measuring and steady:

            measurement = float(np.median(height_history))
            captures.append(measurement)
            height_history.clear()     # next capture uses fresh frames

            imp, met = format_height(measurement)
            print(f"Capture {len(captures)}/{CAPTURES_PER_PATIENT}: {imp} / {met}")
            pending_shot = f"height_capture_{len(captures)}"

            if len(captures) >= CAPTURES_PER_PATIENT:
                final_height_cm = float(np.median(captures))
                spread = max(captures) - min(captures)
                imp, met = format_height(final_height_cm)
                print(f"FINAL HEIGHT: {imp} / {met}  (spread {spread:.1f} cm)")
                if spread > MAX_SPREAD_CM:
                    print("  WARNING: measurements disagree - patient may have moved. "
                          "Consider measuring again.")
                pending_shot = None    # the FINAL screenshot covers the last capture

        # ------------------------------------
        # STAFF INFO PANEL (top left)
        # ------------------------------------

        cv2.rectangle(frame, (5, 5), (min(w - 5, 470), 185), (25, 25, 25), -1)

        if not focal_history:
            cal_text = "SHOW APRILTAG TO CALIBRATE"
        elif not calibrated:
            cal_text = f"CALIBRATING {len(focal_history)}/{MIN_CALIBRATION_FRAMES}"
        elif tag_found:
            cal_text = f"TAG OK  tilt (live): {np.degrees(tilt_used):.1f} deg"
        else:
            cal_text = f"TAG HIDDEN  tilt (last): {np.degrees(tilt_used):.1f} deg"

        cv2.putText(frame, cal_text, (15, 35), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 255), 2)

        if final_height_cm is not None:
            imp, met = format_height(final_height_cm)
            cv2.putText(frame, f"FINAL: {imp}", (15, 70), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 0), 2)
            cv2.putText(frame, met, (15, 100), cv2.FONT_HERSHEY_SIMPLEX, 0.65, (255, 255, 255), 2)
        elif height_history:
            imp, met = format_height(float(np.median(height_history)))
            cv2.putText(frame, f"Height: {imp}", (15, 70), cv2.FONT_HERSHEY_SIMPLEX, 0.65, (255, 255, 255), 2)
            cv2.putText(frame, f"Height: {met}", (15, 100), cv2.FONT_HERSHEY_SIMPLEX, 0.65, (255, 255, 255), 2)

        if pending_shot is not None:
            imp, met = format_height(captures[-1])
            cv2.putText(frame, f"Capture {len(captures)}: {imp}", (15, 70),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.65, (0, 255, 0), 2)

        if captures:
            cap_text = "  ".join(f"{c:.1f}" for c in captures)
            cv2.putText(frame, f"Captures (cm): {cap_text}", (15, 135),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 1)

        if line_distance_cm is None:
            line_text = "Spot: not set - press L"
        elif line_offset_cm is None:
            line_text = "Spot: set"
        elif line_offset_cm <= -99:
            line_text = "Spot: set  ankles below picture (too close)"
        else:
            line_text = f"Spot: set  feet {line_offset_cm:+.1f} cm"
        cv2.putText(frame, line_text, (15, 165),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 255), 1)

        # ------------------------------------
        # PATIENT INSTRUCTIONS (big banner, bottom)
        # ------------------------------------

        if not calibrated:
            draw_banner(frame, "PLEASE WAIT\nSystem starting up", (0, 255, 255))
        elif final_height_cm is not None:
            imp, _ = format_height(final_height_cm)
            draw_banner(frame, f"DONE!  {imp}\nYou may step off", (0, 255, 0))
        elif not person_seen:
            draw_banner(frame, "STAND ON THE FOOTPRINTS\nFace the camera", (255, 255, 255))
        elif not full_body:
            draw_banner(frame, "STEP BACK ONTO THE FOOTPRINTS\nWhole body in view", (0, 165, 255))
        elif off_line and line_offset_cm < 0:
            draw_banner(frame, "STEP BACK\nFeet on the footprints", (0, 165, 255))
        elif off_line:
            draw_banner(frame, "STEP FORWARD\nFeet on the footprints", (0, 165, 255))
        else:
            n = len(captures) + 1
            progress = len(height_history) / STABLE_FRAMES
            draw_banner(
                frame,
                f"STAND TALL - LOOK AHEAD\nHOLD STILL  ({n}/{CAPTURES_PER_PATIENT})",
                (255, 255, 255)
            )
            # Progress bar for the current measurement
            bar_y = h - 8
            cv2.rectangle(frame, (0, bar_y - 6), (int(w * progress), bar_y), (0, 255, 0), -1)

        # Save screenshots now that the panel and banner are drawn
        if pending_shot is not None:
            shot = save_screenshot(frame, pending_shot)
            print(f"  saved: {shot}")

        # Save one final screenshot with the result banner on it
        if final_height_cm is not None and not final_saved:
            shot = save_screenshot(frame, "height_FINAL")
            print(f"Final screenshot saved: {shot}")
            final_saved = True

        # ------------------------------------
        # CAMERA WINDOW
        # ------------------------------------

        cv2.imshow(WINDOW_NAME, frame)

        key = cv2.waitKey(1) & 0xFF

        if key == ord("q"):
            break

        elif key == ord("c"):
            focal_history.clear()
            tilt_history.clear()
            ever_calibrated = False
            print("Recalibrating: keep the booth empty so the AprilTag is visible.")

        elif key == ord("l"):
            if not calibrated:
                print("Can't set the spot yet: wait until the AprilTag calibration finishes.")
            elif len(ankle_row_history) < 5:
                print("Can't set the spot: stand on the footprints with your ankles clearly visible.")
            else:
                taught = point_distance_cm(
                    float(np.median(ankle_row_history)), cy, focal_px, tilt_used,
                    cam_h_cm - ANKLE_HEIGHT_CM
                )
                if taught is None:
                    print("Can't set the spot: ankles not clearly in view.")
                else:
                    line_distance_cm = taught
                    print("Standing spot set. Patients will be asked to step back/forward "
                          f"if they're more than {LINE_TOLERANCE_CM:.0f} cm off it.")

        elif key == ord("s"):
            shot = save_screenshot(frame, "manual_capture")
            print(f"Manual screenshot saved: {shot}")

finally:
    cap.release()
    pose.close()
    cv2.destroyAllWindows()
