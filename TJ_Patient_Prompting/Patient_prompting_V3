class PatientDisplay:
    """Fullscreen text display (pygame). Call update() every loop; it only redraws on change."""

    COLORS = {"normal": (255, 255, 255), "correction": (255, 212, 0), "success": (76, 224, 107)}
    HEADER = "Preventative Care Hub"

    def __init__(self, captions: Dict[str, str], idle_text: str = "", display_index: int = 0,
                 windowed: bool = False, max_font: int = 150, min_font: int = 40):
        pygame.display.init()
        pygame.font.init()
        if windowed:
            self.screen = pygame.display.set_mode((1280, 720))
        else:
            self.screen = pygame.display.set_mode((0, 0), pygame.FULLSCREEN, display=display_index)
        pygame.display.set_caption("Patient Display")
        pygame.mouse.set_visible(False)
        self.W, self.H = self.screen.get_size()
        self.captions = captions
        self.idle_text = idle_text
        self.max_font, self.min_font = max_font, min_font
        self._fonts: Dict[int, pygame.font.Font] = {}
        self._text, self._kind = idle_text, "normal"
        self._dirty = True

    def _font(self, size: int) -> pygame.font.Font:
        if size not in self._fonts:
            self._fonts[size] = pygame.font.SysFont("dejavusans,arial,helvetica,freesans", size, bold=True)
        return self._fonts[size]

    @staticmethod
    def _wrap(text: str, font: pygame.font.Font, max_w: int) -> List[str]:
        lines: List[str] = []
        for paragraph in text.split("\n"):
            current = ""
            for word in paragraph.split():
                trial = f"{current} {word}".strip()
                if current and font.size(trial)[0] > max_w:
                    lines.append(current)
                    current = word
                else:
                    current = trial
            lines.append(current)
        return lines

    def _draw(self) -> None:
        self.screen.fill((0, 0, 0))
        header_font = self._font(max(20, self.H // 26))
        header = header_font.render(self.HEADER, True, (130, 130, 130))
        self.screen.blit(header, ((self.W - header.get_width()) // 2, self.H // 30))

        max_w, max_h = int(self.W * 0.90), int(self.H * 0.70)
        for size in range(self.max_font, self.min_font - 1, -4):
            font = self._font(size)
            lines = self._wrap(self._text, font, max_w)
            if len(lines) * font.get_linesize() <= max_h and all(font.size(l)[0] <= max_w for l in lines):
                break
        color = self.COLORS[self._kind]
        y = (self.H - len(lines) * font.get_linesize()) // 2
        for line in lines:
            surface = font.render(line, True, color)
            self.screen.blit(surface, ((self.W - surface.get_width()) // 2, y))
            y += font.get_linesize()
        pygame.display.flip()

    # ---- public API ----
    def show(self, text: str, kind: str = "normal") -> None:
        if (text, kind) != (self._text, self._kind):
            self._text, self._kind = text, kind
            self._dirty = True

    def show_clip(self, name: str) -> None:
        """Pass this to VoicePlayer.on_start so text appears the moment the audio starts."""
        if name not in self.captions:
            return
        kind = "correction" if name in CORRECTION_CLIPS else "success" if name in SUCCESS_CLIPS else "normal"
        self.show(self.captions[name], kind)

    def show_idle(self) -> None:
        self.show(self.idle_text)

    def update(self) -> bool:
        """Pump window events and redraw if needed. Returns False if the window was closed (Esc)."""
        for event in pygame.event.get():
            if event.type == pygame.QUIT or (event.type == pygame.KEYDOWN and event.key == pygame.K_ESCAPE):
                return False
        if self._dirty:
            self._draw()
            self._dirty = False
        return True

    def close(self) -> None:
        pygame.display.quit()


