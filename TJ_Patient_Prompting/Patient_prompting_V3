# MediaPipe pose landmark indices
NOSE, L_SHOULDER, R_SHOULDER, L_ELBOW, R_ELBOW, L_WRIST, R_WRIST = 0, 11, 12, 13, 14, 15, 16
L_HIP, R_HIP, L_KNEE, R_KNEE, L_ANKLE, R_ANKLE = 23, 24, 25, 26, 27, 28
SKELETON = [(L_SHOULDER, R_SHOULDER), (L_SHOULDER, L_ELBOW), (L_ELBOW, L_WRIST),
            (R_SHOULDER, R_ELBOW), (R_ELBOW, R_WRIST), (L_SHOULDER, L_HIP), (R_SHOULDER, R_HIP),
            (L_HIP, R_HIP), (L_HIP, L_KNEE), (L_KNEE, L_ANKLE), (R_HIP, R_KNEE), (R_KNEE, R_ANKLE)]

Landmark = Tuple[float, float, float, float]   # x, y (normalized), z (relative), visibility


class PoseBackend:
    """Returns 33 (x, y, z, visibility) landmarks for one person, or None."""

    def __init__(self, model_path: Optional[str] = None):
        if not HAS_MEDIAPIPE:
            raise RuntimeError("mediapipe is not installed (pip install mediapipe)")
        self._legacy = None
        self._task = None
        self._last_ts = 0
        if hasattr(mp, "solutions") and hasattr(mp.solutions, "pose"):
            self._legacy = mp.solutions.pose.Pose(model_complexity=1, smooth_landmarks=True,
                                                  min_detection_confidence=0.5,
                                                  min_tracking_confidence=0.5)
            self.name = "mediapipe (solutions API)"
        else:
            if not model_path:
                raise RuntimeError(
                    "This MediaPipe version needs a model file. Download pose_landmarker_lite.task "
                    "from the MediaPipe model page and pass --pose-model path/to/it.task")
            from mediapipe.tasks import python as mp_python
            from mediapipe.tasks.python import vision
            options = vision.PoseLandmarkerOptions(
                base_options=mp_python.BaseOptions(model_asset_path=model_path),
                running_mode=vision.RunningMode.VIDEO, num_poses=1)
            self._task = vision.PoseLandmarker.create_from_options(options)
            self.name = "mediapipe (tasks API)"

    def detect(self, bgr: np.ndarray) -> Optional[List[Landmark]]:
        rgb = cv2.cvtColor(bgr, cv2.COLOR_BGR2RGB)
        if self._legacy is not None:
            result = self._legacy.process(rgb)
            if not result.pose_landmarks:
                return None
            points = result.pose_landmarks.landmark
        else:
            self._last_ts = max(self._last_ts + 1, int(time.monotonic() * 1000))
            image = mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb)
            result = self._task.detect_for_video(image, self._last_ts)
            if not result.pose_landmarks:
                return None
            points = result.pose_landmarks[0]
        return [(p.x, p.y, p.z, p.visibility) for p in points]


@dataclass
class PoseMetrics:
    """What the camera currently sees. Keys mirror the V1 'camera_data' flags, plus new ones."""
    person_present: bool = False
    full_body_visible: bool = False
    patient_on_footprints: bool = False
    facing_camera: bool = False
    feet_together: bool = False
    arms_at_sides: bool = False
    posture_straight: bool = False
    is_still: bool = False
    distance_m: Optional[float] = None
    details: Dict[str, float] = field(default_factory=dict)


class PoseAnalyzer:
    def __init__(self, settings: Settings):
        self.s = settings
        self._history: Deque[Tuple[float, np.ndarray, float]] = deque()  # (time, points, shoulder_w)

    def analyze(self, lms: Optional[Sequence[Landmark]], now: float,
                distance_m: Optional[float] = None) -> PoseMetrics:
        m = PoseMetrics(distance_m=distance_m)
        if lms is None:
            self._history.clear()
            return m
        s = self.s
        vis = lambda i: lms[i][3] >= s.min_visibility
        xy = lambda i: np.array(lms[i][:2], dtype=float)

        core = [L_SHOULDER, R_SHOULDER, L_HIP, R_HIP]
        m.person_present = all(vis(i) for i in core)
        if not m.person_present:
            self._history.clear()
            return m
        m.full_body_visible = all(vis(i) for i in (L_ANKLE, R_ANKLE)) and \
            max(lms[L_ANKLE][1], lms[R_ANKLE][1]) < 1.0

        shoulder_w = max(float(np.linalg.norm(xy(L_SHOULDER) - xy(R_SHOULDER))), 1e-3)
        shoulder_mid = (xy(L_SHOULDER) + xy(R_SHOULDER)) / 2
        hip_mid = (xy(L_HIP) + xy(R_HIP)) / 2
        torso_len = max(float(np.linalg.norm(hip_mid - shoulder_mid)), 1e-3)

        # Facing the camera: left shoulder appears on the image's right, and the shoulders are
        # at about the same depth (a turned body has a large depth difference).
        z_gap = abs(lms[L_SHOULDER][2] - lms[R_SHOULDER][2]) / shoulder_w
        m.facing_camera = lms[L_SHOULDER][0] > lms[R_SHOULDER][0] and z_gap < s.facing_depth_ratio_max
        m.details["shoulder_z_gap"] = z_gap

        # Standing on the footprints: ankles inside the calibrated box (and distance if known)
        if m.full_body_visible:
            ankle_mid = (xy(L_ANKLE) + xy(R_ANKLE)) / 2
            x0, y0, x1, y1 = s.footprint_box
            in_box = x0 <= ankle_mid[0] <= x1 and y0 <= ankle_mid[1] <= y1
            in_range = True if distance_m is None else s.station_depth_m[0] <= distance_m <= s.station_depth_m[1]
            m.patient_on_footprints = bool(in_box and in_range)
            m.details["ankle_x"], m.details["ankle_y"] = float(ankle_mid[0]), float(ankle_mid[1])

            gap = float(np.linalg.norm(xy(L_ANKLE) - xy(R_ANKLE))) / shoulder_w
            m.feet_together = gap <= s.feet_together_max
            m.details["feet_gap"] = gap

        # Arms at sides: each wrist close to its hip sideways and not raised above the hip
        if vis(L_WRIST) and vis(R_WRIST):
            offsets = [abs(lms[w][0] - lms[h][0]) / shoulder_w for w, h in ((L_WRIST, L_HIP), (R_WRIST, R_HIP))]
            low_enough = all(lms[w][1] > lms[h][1] - 0.15 * torso_len for w, h in ((L_WRIST, L_HIP), (R_WRIST, R_HIP)))
            m.arms_at_sides = max(offsets) <= s.arm_offset_max and low_enough
            m.details["arm_offset"] = max(offsets)

        # Posture: torso upright, shoulders level, head over shoulders
        torso_vec = hip_mid - shoulder_mid
        tilt = math.degrees(math.atan2(abs(torso_vec[0]), max(torso_vec[1], 1e-6)))
        level = abs(lms[L_SHOULDER][1] - lms[R_SHOULDER][1]) / shoulder_w
        head = abs(lms[NOSE][0] - shoulder_mid[0]) / shoulder_w if vis(NOSE) else 0.0
        m.posture_straight = tilt <= s.torso_tilt_max_deg and level <= s.shoulder_level_max and head <= s.head_offset_max
        m.details.update(tilt_deg=tilt, shoulder_level=level, head_offset=head)

        # Stillness: average movement of head/shoulders/hips over the last ~0.6 s
        pts = np.array([xy(i) for i in (NOSE, L_SHOULDER, R_SHOULDER, L_HIP, R_HIP)])
        self._history.append((now, pts, shoulder_w))
        while self._history and now - self._history[0][0] > 0.6:
            self._history.popleft()
        if len(self._history) >= 4 and now - self._history[0][0] >= 0.4:
            path = sum(float(np.mean(np.linalg.norm(b[1] - a[1], axis=1))) / shoulder_w
                       for a, b in zip(self._history, list(self._history)[1:]))
            speed = path / (now - self._history[0][0])
            m.is_still = speed <= s.still_speed_max
            m.details["speed"] = speed
        return m


# =============================================================================
#  5. STATE MACHINE  (same state names as V1, driven by the camera instead of timers)
# =============================================================================

class IntakeStateMachine:
    def __init__(self, player: VoicePlayer, settings: Settings, on_measure=None):
        self.player = player
        self.s = settings
        self.on_measure = on_measure          # called once with PoseMetrics when measuring succeeds
        self.state = "IDLE"
        self.entered_at = time.monotonic()
        self._since: Dict[str, float] = {}
        self._last_correction = -1e9
        self._last_reminder = time.monotonic()
        self._enter("IDLE", self.entered_at)

    # ---- helpers -------------------------------------------------------------
    def _enter(self, state: str, now: float) -> None:
        self.state = state
        self.entered_at = now
        self._since.clear()
        self._last_correction = now
        self._last_reminder = now
        clips = SCRIPT.get(state, {}).get("clips")
        if clips:
            self.player.say(*clips)
        print(f"[state] {state}")

    def _lasting(self, key: str, flag: bool, now: float) -> float:
        """Seconds that `flag` has been continuously true (0 if false now)."""
        if flag:
            return now - self._since.setdefault(key, now)
        self._since.pop(key, None)
        return 0.0

    def _correct(self, clip: str, now: float) -> None:
        if not self.player.busy and now - self._last_correction >= self.s.correction_cooldown:
            self.player.say(clip)
            self._last_correction = now

    # ---- main update ---------------------------------------------------------
    def update(self, m: PoseMetrics, now: float) -> None:
        s, state = self.s, self.state

        # Reset if the patient walks away mid-session
        away = self._lasting("away", not m.person_present, now)
        if state not in ("IDLE", "COMPLETED") and away >= s.abandon_timeout:
            self.player.stop()
            self._enter("IDLE", now)
            return

        if state == "IDLE":
            if self._lasting("present", m.person_present, now) >= s.hold_to_confirm:
                self._enter("WELCOME", now)

        elif "next" in SCRIPT.get(state, {}):   # timed, audio-only steps
            cfg = SCRIPT[state]
            if not self.player.busy and self.player.silent_for() >= cfg["pause_after"]:
                self._enter(cfg["next"], now)

        elif state == "WAIT_FOR_PATIENT_POSITION":
            ready = m.patient_on_footprints and m.facing_camera
            if self._lasting("ready", ready, now) >= s.hold_to_confirm:
                self._enter("POSTURE_ALIGNMENT", now)
            elif not self.player.busy and now - self._last_reminder >= s.reminder_interval:
                self.player.say("STAND_ON_FOOTPRINTS")
                self._last_reminder = now

        elif state == "POSTURE_ALIGNMENT":
            if self._lasting("off_mat", not m.patient_on_footprints, now) >= s.leave_footprints_timeout:
                self._enter("WAIT_FOR_PATIENT_POSITION", now)
                return
            ok = m.feet_together and m.arms_at_sides and m.posture_straight
            if self._lasting("ok", ok, now) >= s.hold_to_confirm:
                self._enter("MEASURING", now)
                return
            if self.player.silent_for() >= s.instruction_grace:
                # Speak about one problem at a time, most important first
                problems = [(self._lasting("feet", not m.feet_together, now), "FEET_TOGETHER"),
                            (self._lasting("arms", not m.arms_at_sides, now), "ARMS_AT_SIDES"),
                            (self._lasting("posture", not m.posture_straight, now), "STAND_STRAIGHT")]
                for duration, clip in problems:
                    if duration >= s.correction_delay:
                        self._correct(clip, now)
                        break

        elif state == "MEASURING":
            if self._lasting("off_mat", not m.patient_on_footprints, now) >= s.leave_footprints_timeout:
                self._enter("WAIT_FOR_PATIENT_POSITION", now)
                return
            if self.player.busy or self.player.silent_for() < s.instruction_grace:
                self._since.pop("still", None)       # don't start timing until instructions end
                return
            if self._lasting("moving", not m.is_still, now) >= 0.5:
                self._since.pop("still", None)
                self._correct("HOLD_STILL", now)
            if self._lasting("still", m.is_still and m.posture_straight, now) >= s.measure_hold:
                if self.on_measure:
                    self.on_measure(m)               # <-- hook for your real measurement code
                self._enter("SUCCESS_STATION_2", now)

        elif state == "COMPLETED":
            if self._lasting("gone", not m.person_present, now) >= s.finish_reset_delay:
                self._enter("IDLE", now)


# =============================================================================
#  6. OVERLAY + MAIN LOOP
# =============================================================================

def draw_overlay(frame: np.ndarray, lms, m: PoseMetrics, machine: IntakeStateMachine,
                 player: VoicePlayer, settings: Settings) -> None:
    h, w = frame.shape[:2]
    x0, y0, x1, y1 = settings.footprint_box
    cv2.rectangle(frame, (int(x0 * w), int(y0 * h)), (int(x1 * w), int(y1 * h)), (255, 200, 0), 2)
    if lms:
        for a, b in SKELETON:
            if lms[a][3] > 0.5 and lms[b][3] > 0.5:
                cv2.line(frame, (int(lms[a][0] * w), int(lms[a][1] * h)),
                         (int(lms[b][0] * w), int(lms[b][1] * h)), (0, 255, 0), 2)
    cv2.putText(frame, f"State: {machine.state}", (20, 35), cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 255, 0), 2)
    speaking = f"Playing: {player.current}" if player.busy else f"Last clip: {player.last_clip}"
    cv2.putText(frame, speaking, (20, 65), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 2)
    checks = [("present", m.person_present), ("on footprints", m.patient_on_footprints),
              ("facing", m.facing_camera), ("feet together", m.feet_together),
              ("arms at sides", m.arms_at_sides), ("straight", m.posture_straight), ("still", m.is_still)]
    for i, (label, ok) in enumerate(checks):
        cv2.putText(frame, f"{label}: {'OK' if ok else 'no'}", (20, 100 + 24 * i),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.55, (0, 255, 0) if ok else (0, 0, 255), 2)
    if m.distance_m is not None:
        cv2.putText(frame, f"distance: {m.distance_m:.2f} m", (20, 100 + 24 * len(checks)),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.55, (255, 255, 255), 2)


def preview_clips(library: AudioClipLibrary, display: Optional[PatientDisplay] = None) -> None:
    """Play every clip in order so you can confirm the labels in CLIPS and the text in CAPTIONS."""
    player = VoicePlayer(library, gap=0.5)
    if display:
        player.on_start = display.show_clip
    for name in library.names():
        print(f"Playing {name}  ({library.duration(name):.2f} s)")
        player.say(name)
        while player.busy:
            player.update()
            if display and not display.update():
                return
            time.sleep(0.02)


def run(args: argparse.Namespace) -> None:
    settings = Settings()
    if args.footprint_box:
        settings.footprint_box = tuple(args.footprint_box)  # type: ignore[assignment]

    library = AudioClipLibrary(Path(args.audio), CLIPS)
    if args.export_clips:
        for path in library.export_all(Path(args.export_clips)):
            print("wrote", path)
        return
    display: Optional[PatientDisplay] = None
    if not args.no_patient_display:
        display = PatientDisplay(CAPTIONS, IDLE_TEXT, args.display_index, args.patient_windowed)
    if args.preview:
        preview_clips(library, display)
        if display:
            display.close()
        return

    use_orbbec = args.source == "orbbec" or (args.source == "auto" and HAS_ORBBEC)
    source = OrbbecSource(args.width, args.height, args.fps) if use_orbbec else WebcamSource(args.cam_index)
    backend = PoseBackend(args.pose_model)
    print(f"[camera] {'Orbbec' if use_orbbec else 'OpenCV source'}   [pose] {backend.name}")

    player = VoicePlayer(library)
    if display:
        player.on_start = display.show_clip
    analyzer = PoseAnalyzer(settings)
    machine = IntakeStateMachine(player, settings,
                                 on_measure=lambda m: print("[measure] captured", m.details))
    last_state = None
    try:
        while True:
            bundle = source.read()
            if bundle is None:
                continue
            now = time.monotonic()
            lms = backend.detect(bundle.color_bgr)

            distance = None
            if lms is not None and lms[L_HIP][3] > 0.5 and lms[R_HIP][3] > 0.5:
                distance = bundle.distance_at((lms[L_HIP][0] + lms[R_HIP][0]) / 2,
                                              (lms[L_HIP][1] + lms[R_HIP][1]) / 2)
            metrics = analyzer.analyze(lms, now, distance)
            machine.update(metrics, now)
            player.update()

            if display:
                if machine.state != last_state:
                    last_state = machine.state
                    if last_state == "IDLE":
                        display.show_idle()
                if not display.update():
                    break

            if not args.no_display:
                draw_overlay(bundle.color_bgr, lms, metrics, machine, player, settings)
                cv2.imshow("Preventative Care Hub - Vision Intake", bundle.color_bgr)
                if cv2.waitKey(1) & 0xFF == ord("q"):
                    break
    except KeyboardInterrupt:
        pass
    finally:
        player.stop()
        source.close()
        if display:
            display.close()
        cv2.destroyAllWindows()


def parse_args() -> argparse.Namespace:
    p = argparse.ArgumentParser(description="Camera-guided intake with recorded voice prompts")
    p.add_argument("--source", choices=["auto", "orbbec", "webcam"], default="auto")
    p.add_argument("--cam-index", default="0", help="webcam index or video file path (webcam source)")
    p.add_argument("--width", type=int, default=1280)
    p.add_argument("--height", type=int, default=720)
    p.add_argument("--fps", type=int, default=30)
    p.add_argument("--audio", default=str(AUDIO_FILE), help="path to V1_Patient_Prompts.mp3")
    p.add_argument("--pose-model", default=None, help="pose_landmarker_lite.task (newer MediaPipe only)")
    p.add_argument("--footprint-box", type=float, nargs=4, metavar=("X0", "Y0", "X1", "Y1"),
                   help="normalized ankle zone for the footprints, e.g. 0.3 0.7 0.7 1.0")
    p.add_argument("--no-display", action="store_true", help="headless mode (no operator video window)")
    p.add_argument("--no-patient-display", action="store_true", help="disable the patient-facing text display")
    p.add_argument("--display-index", type=int, default=0, help="monitor number for the patient text (0, 1, ...)")
    p.add_argument("--patient-windowed", action="store_true", help="show patient text in a window, not fullscreen")
    p.add_argument("--preview", action="store_true", help="play every clip in order, then exit")
    p.add_argument("--export-clips", metavar="DIR", help="write each clip as a WAV file, then exit")
    return p.parse_args()


if __name__ == "__main__":
    try:
        run(parse_args())
    except (RuntimeError, FileNotFoundError) as error:
        sys.exit(f"Error: {error}")
