@dataclass
class FrameBundle:
    color_bgr: np.ndarray
    depth_m: Optional[np.ndarray] = None    # same scene as color, in meters (0 = no reading)

    def distance_at(self, nx: float, ny: float, radius: int = 7) -> Optional[float]:
        """Median depth in meters around a normalized image point, or None."""
        if self.depth_m is None:
            return None
        h, w = self.depth_m.shape
        cx, cy = int(np.clip(nx, 0, 1) * (w - 1)), int(np.clip(ny, 0, 1) * (h - 1))
        patch = self.depth_m[max(0, cy - radius):cy + radius + 1, max(0, cx - radius):cx + radius + 1]
        valid = patch[patch > 0]
        return float(np.median(valid)) if valid.size else None


def _orbbec_color_to_bgr(frame) -> np.ndarray:
    """Convert an Orbbec color frame (any common format) to an OpenCV BGR image."""
    w, h, fmt = frame.get_width(), frame.get_height(), frame.get_format()
    data = np.frombuffer(frame.get_data(), dtype=np.uint8)
    if fmt == OBFormat.RGB:
        return cv2.cvtColor(data.reshape(h, w, 3), cv2.COLOR_RGB2BGR)
    if fmt == OBFormat.BGR:
        return data.reshape(h, w, 3).copy()
    if fmt == OBFormat.MJPG:
        return cv2.imdecode(data, cv2.IMREAD_COLOR)
    if fmt in (OBFormat.YUYV, OBFormat.YUY2):
        return cv2.cvtColor(data.reshape(h, w, 2), cv2.COLOR_YUV2BGR_YUY2)
    if fmt == OBFormat.UYVY:
        return cv2.cvtColor(data.reshape(h, w, 2), cv2.COLOR_YUV2BGR_UYVY)
    if fmt == OBFormat.I420:
        return cv2.cvtColor(data.reshape(h * 3 // 2, w), cv2.COLOR_YUV2BGR_I420)
    if fmt == OBFormat.NV12:
        return cv2.cvtColor(data.reshape(h * 3 // 2, w), cv2.COLOR_YUV2BGR_NV12)
    if fmt == OBFormat.NV21:
        return cv2.cvtColor(data.reshape(h * 3 // 2, w), cv2.COLOR_YUV2BGR_NV21)
    raise RuntimeError(f"Unsupported Orbbec color format: {fmt}")


class OrbbecSource:
    """Gemini 335 color stream plus depth aligned to color (software D2C)."""

    def __init__(self, width: int = 1280, height: int = 720, fps: int = 30):
        if not HAS_ORBBEC:
            raise RuntimeError("pyorbbecsdk is not installed (pip install pyorbbecsdk2)")
        self.pipeline = Pipeline()
        self.has_depth = False
        try:
            self._start(width, height, fps, with_depth=True)
            self.has_depth = True
        except Exception as error:   # fall back to color only
            print(f"[camera] depth/alignment unavailable ({error}); continuing with color only")
            self.pipeline = Pipeline()
            self._start(width, height, fps, with_depth=False)

    def _start(self, width: int, height: int, fps: int, with_depth: bool) -> None:
        config = Config()
        color_profiles = self.pipeline.get_stream_profile_list(OBSensorType.COLOR_SENSOR)
        color_profile = None
        for fmt in (OBFormat.RGB, OBFormat.MJPG, OBFormat.BGR):
            try:
                color_profile = color_profiles.get_video_stream_profile(width, height, fmt, fps)
                break
            except Exception:
                continue
        if color_profile is None:
            color_profile = color_profiles.get_default_video_stream_profile()
        config.enable_stream(color_profile)
        if with_depth:
            depth_profiles = self.pipeline.get_stream_profile_list(OBSensorType.DEPTH_SENSOR)
            config.enable_stream(depth_profiles.get_default_video_stream_profile())
            config.set_align_mode(OBAlignMode.SW_MODE)
            config.set_frame_aggregate_output_mode(OBFrameAggregateOutputMode.FULL_FRAME_REQUIRE)
        self.pipeline.start(config)

    def read(self) -> Optional[FrameBundle]:
        frames = self.pipeline.wait_for_frames(200)
        if frames is None:
            return None
        color = frames.get_color_frame()
        if color is None:
            return None
        bgr = _orbbec_color_to_bgr(color)
        depth_m = None
        if self.has_depth:
            depth = frames.get_depth_frame()
            if depth is not None:
                w, h = depth.get_width(), depth.get_height()
                raw = np.frombuffer(depth.get_data(), dtype=np.uint16)
                if raw.size == w * h:
                    # raw units * scale = millimeters -> /1000 = meters
                    depth_m = raw.reshape(h, w).astype(np.float32) * depth.get_depth_scale() / 1000.0
        return FrameBundle(bgr, depth_m)

    def close(self) -> None:
        self.pipeline.stop()


class WebcamSource:
    """Any OpenCV source: webcam index or a video file path. No depth."""

    def __init__(self, index="0"):
        self.cap = cv2.VideoCapture(int(index) if str(index).isdigit() else str(index))
        if not self.cap.isOpened():
            raise RuntimeError(f"Could not open video source {index!r}")

    def read(self) -> Optional[FrameBundle]:
        ok, frame = self.cap.read()
        return FrameBundle(frame) if ok else None

    def close(self) -> None:
        self.cap.release()


