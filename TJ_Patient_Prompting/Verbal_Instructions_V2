class AudioClipLibrary:
    """Loads the MP3 once and cuts it into named, playable clips."""

    def __init__(self, audio_path: Path, clips: Dict[str, Tuple[float, float]],
                 pad_start: float = CLIP_PAD_START, pad_end: float = CLIP_PAD_END):
        if not Path(audio_path).exists():
            raise FileNotFoundError(f"Audio file not found: {audio_path}")
        if pygame.mixer.get_init() is None:
            pygame.mixer.init(frequency=44100, size=-16, channels=1)
        self.frequency, fmt, self.channels = pygame.mixer.get_init()
        self._sample_width = abs(fmt) // 8
        self._frame_bytes = self._sample_width * self.channels

        full = pygame.mixer.Sound(str(audio_path))
        raw = full.get_raw()
        total = full.get_length()

        self._raw: Dict[str, bytes] = {}
        self._sounds: Dict[str, pygame.mixer.Sound] = {}
        for name, (start, end) in clips.items():
            start = max(0.0, start - pad_start)
            end = min(total, end + pad_end)
            piece = raw[int(start * self.frequency) * self._frame_bytes:
                        int(end * self.frequency) * self._frame_bytes]
            self._raw[name] = piece
            self._sounds[name] = pygame.mixer.Sound(buffer=piece)

    def names(self) -> List[str]:
        return list(self._sounds)

    def get(self, name: str) -> pygame.mixer.Sound:
        """Return a playable pygame Sound for this clip (call .play() on it)."""
        return self._sounds[name]

    def duration(self, name: str) -> float:
        return self._sounds[name].get_length()

    def export_all(self, out_dir: Path) -> List[Path]:
        """Write every clip as its own WAV file and return the paths."""
        out_dir = Path(out_dir)
        out_dir.mkdir(parents=True, exist_ok=True)
        paths = []
        for index, name in enumerate(self._raw, start=1):
            path = out_dir / f"{index:02d}_{name}.wav"
            with wave.open(str(path), "wb") as wav:
                wav.setnchannels(self.channels)
                wav.setsampwidth(self._sample_width)
                wav.setframerate(self.frequency)
                wav.writeframes(self._raw[name])
            paths.append(path)
        return paths


class VoicePlayer:
    """Non-blocking player with a queue. Never interrupts a clip that is already speaking.

    Honors Settings: gap_between_clips / gap_before (silence between clips), clip_enabled
    (per-clip on/off) and muted (skip everything). force=True bypasses enabled/muted, for
    manual operator triggers.
    """

    def __init__(self, library: AudioClipLibrary, settings: Settings):
        self.library = library
        self.s = settings
        self.queue: Deque[Tuple[str, bool]] = deque()
        self.channel: Optional[pygame.mixer.Channel] = None
        self.current: Optional[str] = None
        self.last_clip: Optional[str] = None
        self._was_busy = False
        self._finished_at = time.monotonic()

    def say(self, *names: str, interrupt: bool = False, force: bool = False) -> None:
        if interrupt:
            self.stop()
        for name in names:
            if name not in self.library.names():
                raise KeyError(f"Unknown clip '{name}'")
            self.queue.append((name, force))

    def stop(self) -> None:
        self.queue.clear()
        if self.channel is not None:
            self.channel.stop()

    @property
    def busy(self) -> bool:
        return bool(self.queue) or (self.channel is not None and self.channel.get_busy())

    def silent_for(self) -> float:
        """Seconds since the last clip finished or was skipped (0 while audio is playing/queued)."""
        return 0.0 if self.busy else time.monotonic() - self._finished_at

    def update(self) -> None:
        now = time.monotonic()
        playing = self.channel is not None and self.channel.get_busy()
        if self._was_busy and not playing:
            self._finished_at = now
        self._was_busy = playing
        if playing or not self.queue:
            return
        name, force = self.queue[0]
        allowed = force or (self.s.clip_enabled.get(name, True) and not self.s.muted)
        if not allowed:                       # skipped clips still count as "just finished"
            self.queue.popleft()
            self._finished_at = now
            return
        gap = 0.0 if force else self.s.gap_before.get(name, self.s.gap_between_clips)
        if now - self._finished_at >= gap:
            self.queue.popleft()
            self.current = self.last_clip = name
            self.channel = self.library.get(name).play()
            self._was_busy = True


