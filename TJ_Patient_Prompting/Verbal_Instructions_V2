def apply_config(settings: Settings, path: Path) -> bool:
    """Copy values from the JSON file into `settings` in place. Returns True if a file was read."""
    if not Path(path).exists():
        return False
    data = json.loads(Path(path).read_text(encoding="utf-8"))
    known = {f.name for f in fields(Settings)}
    for key, value in data.items():
        if key.startswith("_"):
            continue                                   # allow "_comment" entries
        if key not in known:
            print(f"[config] ignoring unknown setting '{key}'")
            continue
        if key == "footprint_box" or key == "station_depth_m":
            value = tuple(value)
        elif key in ("gap_before", "pause_after", "clip_enabled"):
            merged = dict(getattr(settings, key))
            merged.update(value)
            value = merged
        setattr(settings, key, value)
    return True


def write_default_config(path: Path) -> None:
    data = {f.name: getattr(Settings(), f.name) for f in fields(Settings)}
    data["footprint_box"] = list(data["footprint_box"])
    data["station_depth_m"] = list(data["station_depth_m"])
    data = {"_comment": "Times are in seconds. Edit and save while the program runs; it reloads automatically.",
            **data}
    Path(path).write_text(json.dumps(data, indent=2), encoding="utf-8")


def in_play_window(settings: Settings, now: Optional[datetime] = None) -> bool:
    """True if audio/guidance is allowed at this time of day (supports overnight windows)."""
    window = settings.play_window
    if not window:
        return True
    now = now or datetime.now()
    start = datetime.strptime(window["start"], "%H:%M").time()
    end = datetime.strptime(window["end"], "%H:%M").time()
    t = now.time()
    return start <= t < end if start <= end else (t >= start or t < end)



