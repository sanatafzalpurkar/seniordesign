    arm_offset_max: float = 0.45        # wrist-to-hip sideways gap / shoulder width
    torso_tilt_max_deg: float = 8.0     # shoulder-mid to hip-mid line vs vertical
    shoulder_level_max: float = 0.12    # left/right shoulder height difference / shoulder width
